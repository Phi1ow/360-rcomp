--- a/XenonUtils/ppc_context.h
+++ b/XenonUtils/ppc_context.h
@@ -159,6 +159,49 @@
 #define PPC_TRAP(addr) __builtin_trap()
 #endif
 
+// R-comp patch 0023: integer division (divw divwu divd divdu and their record / OE
+// forms). On Xenon a zero divisor, or the most negative value divided by -1 for the
+// signed forms, does not trap and leaves an architecturally undefined quotient; a raw
+// C++ division of those operands raises SIGFPE on x86-64. These defaults never trap:
+// divisor 0 -> 0, most negative / -1 -> most negative (wrap). That is a deterministic
+// choice, not what the hardware returns. *_OVERFLOW is the XER[OV] of the OE forms.
+// A host that defines PPC_DIVW defines all eight macros (the R-comp prelude does, with
+// the same values).
+#ifndef PPC_DIVW
+inline int32_t ppc_divw_default(int32_t a, int32_t b) noexcept
+{
+    return b == 0 ? 0 : b == -1 ? int32_t(0u - uint32_t(a)) : a / b;
+}
+inline uint32_t ppc_divwu_default(uint32_t a, uint32_t b) noexcept
+{
+    return b == 0 ? 0 : a / b;
+}
+inline int64_t ppc_divd_default(int64_t a, int64_t b) noexcept
+{
+    return b == 0 ? 0 : b == -1 ? int64_t(0ull - uint64_t(a)) : a / b;
+}
+inline uint64_t ppc_divdu_default(uint64_t a, uint64_t b) noexcept
+{
+    return b == 0 ? 0 : a / b;
+}
+inline uint8_t ppc_divw_overflow_default(int32_t a, int32_t b) noexcept
+{
+    return b == 0 || (b == -1 && a == INT32_MIN);
+}
+inline uint8_t ppc_divd_overflow_default(int64_t a, int64_t b) noexcept
+{
+    return b == 0 || (b == -1 && a == INT64_MIN);
+}
+#define PPC_DIVW(a, b) ppc_divw_default((a), (b))
+#define PPC_DIVWU(a, b) ppc_divwu_default((a), (b))
+#define PPC_DIVD(a, b) ppc_divd_default((a), (b))
+#define PPC_DIVDU(a, b) ppc_divdu_default((a), (b))
+#define PPC_DIVW_OVERFLOW(a, b) ppc_divw_overflow_default((a), (b))
+#define PPC_DIVWU_OVERFLOW(a, b) uint8_t(uint32_t(b) == 0)
+#define PPC_DIVD_OVERFLOW(a, b) ppc_divd_overflow_default((a), (b))
+#define PPC_DIVDU_OVERFLOW(a, b) uint8_t(uint64_t(b) == 0)
+#endif
+
 #ifndef PPC_CALL_FUNC
 #define PPC_CALL_FUNC(x) x(ctx, base)
 #endif
