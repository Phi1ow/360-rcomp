diff -ru a/XenonUtils/ppc_context.h b/XenonUtils/ppc_context.h
--- a/XenonUtils/ppc_context.h	2026-10-03 03:49:27.916229900 +0200
+++ b/XenonUtils/ppc_context.h	2026-10-03 03:51:49.924806200 +0200
@@ -41,20 +41,29 @@
 #define PPC_FUNC_PROLOGUE() __builtin_assume(((size_t)base & 0x1F) == 0)
 #endif
 
+// R-comp patch 0020. Host pointer (uint8_t*) of the guest data address `x` (a 32-bit
+// effective address). The generated code and the defaults below reach guest data only
+// through it (or PPC_LOAD_*/PPC_STORE_*/PPC_VSTORE128); code addresses, the function
+// table and `base` passed to calls do not use it. The default is the flat mapping; a
+// host whose CPU address translation is not `base + x` overrides it.
+#ifndef PPC_HOST_PTR
+#define PPC_HOST_PTR(x) (base + (x))
+#endif
+
 #ifndef PPC_LOAD_U8
-#define PPC_LOAD_U8(x) *(volatile uint8_t*)(base + (x))
+#define PPC_LOAD_U8(x) *(volatile uint8_t*)PPC_HOST_PTR(x)
 #endif
 
 #ifndef PPC_LOAD_U16
-#define PPC_LOAD_U16(x) __builtin_bswap16(*(volatile uint16_t*)(base + (x)))
+#define PPC_LOAD_U16(x) __builtin_bswap16(*(volatile uint16_t*)PPC_HOST_PTR(x))
 #endif
 
 #ifndef PPC_LOAD_U32
-#define PPC_LOAD_U32(x) __builtin_bswap32(*(volatile uint32_t*)(base + (x)))
+#define PPC_LOAD_U32(x) __builtin_bswap32(*(volatile uint32_t*)PPC_HOST_PTR(x))
 #endif
 
 #ifndef PPC_LOAD_U64
-#define PPC_LOAD_U64(x) __builtin_bswap64(*(volatile uint64_t*)(base + (x)))
+#define PPC_LOAD_U64(x) __builtin_bswap64(*(volatile uint64_t*)PPC_HOST_PTR(x))
 #endif
 
 // TODO: Implement.
@@ -78,19 +87,19 @@
 #endif
 
 #ifndef PPC_STORE_U8
-#define PPC_STORE_U8(x, y) *(volatile uint8_t*)(base + (x)) = (y)
+#define PPC_STORE_U8(x, y) *(volatile uint8_t*)PPC_HOST_PTR(x) = (y)
 #endif
 
 #ifndef PPC_STORE_U16
-#define PPC_STORE_U16(x, y) *(volatile uint16_t*)(base + (x)) = __builtin_bswap16(y)
+#define PPC_STORE_U16(x, y) *(volatile uint16_t*)PPC_HOST_PTR(x) = __builtin_bswap16(y)
 #endif
 
 #ifndef PPC_STORE_U32
-#define PPC_STORE_U32(x, y) *(volatile uint32_t*)(base + (x)) = __builtin_bswap32(y)
+#define PPC_STORE_U32(x, y) *(volatile uint32_t*)PPC_HOST_PTR(x) = __builtin_bswap32(y)
 #endif
 
 #ifndef PPC_STORE_U64
-#define PPC_STORE_U64(x, y) *(volatile uint64_t*)(base + (x)) = __builtin_bswap64(y)
+#define PPC_STORE_U64(x, y) *(volatile uint64_t*)PPC_HOST_PTR(x) = __builtin_bswap64(y)
 #endif
 
 // MMIO Store handling is completely reliant on being preeceded by eieio.
@@ -120,7 +129,7 @@
 // whether the store changed anything overrides the macro and compares the old bytes.
 #ifndef PPC_VSTORE128
 #define PPC_VSTORE128(ea, value) do { const uint32_t ppc_vstore_ea_ = (ea); \
-    simde_mm_store_si128((simde__m128i*)(base + ppc_vstore_ea_), (value)); \
