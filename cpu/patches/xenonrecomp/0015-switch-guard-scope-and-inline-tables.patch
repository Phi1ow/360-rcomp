 // how many instructions to search backwards; `indexReg` (when not -1) is the
 // register the table is indexed with and must be the register the guarding
 // cmplwi tests, so an unrelated compare is never taken for the bound.
+// Instructions whose first operand is a GPR they write. A hoisted guard is only
+// valid while the index register keeps the value it compared.
+static bool WritesFirstGpr(uint32_t id)
+{
+    switch (id)
+    {
+    case PPC_INST_LI: case PPC_INST_LIS: case PPC_INST_ADDI: case PPC_INST_ADDIS: case PPC_INST_ADD:
+    case PPC_INST_SUBF: case PPC_INST_MR: case PPC_INST_LWZ: case PPC_INST_LWZX: case PPC_INST_LWZU:
+    case PPC_INST_LBZ: case PPC_INST_LBZX: case PPC_INST_LHZ: case PPC_INST_LHZX: case PPC_INST_RLWINM:
+    case PPC_INST_CLRLWI: case PPC_INST_ORI: case PPC_INST_OR: case PPC_INST_AND: case PPC_INST_ANDI:
+    case PPC_INST_EXTSW: case PPC_INST_EXTSB: case PPC_INST_EXTSH: case PPC_INST_NEG: case PPC_INST_SRAWI:
+    case PPC_INST_MULLI:
+        return true;
+    default:
+        return false;
+    }
+}
