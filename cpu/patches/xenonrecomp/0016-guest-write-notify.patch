diff -ru a/XenonUtils/ppc_context.h b/XenonUtils/ppc_context.h
--- a/XenonUtils/ppc_context.h	2026-09-30 16:24:20.044924700 +0200
+++ b/XenonUtils/ppc_context.h	2026-09-30 16:25:10.359126700 +0200
@@ -107,6 +107,13 @@
 #define PPC_MM_STORE_U32(x, y)  PPC_STORE_U32(x, y)
 #endif
 
+// Direct guest memory writes that do not use PPC_STORE_* (vector stores, dcbz,
+// store-conditional, setjmp) are followed by PPC_WRITE_NOTIFY(address, size)
+// so a runtime can observe every guest CPU write. Default: no observer.
+#ifndef PPC_WRITE_NOTIFY
+#define PPC_WRITE_NOTIFY(x, size) ((void)0)
+#endif
+
 #ifndef PPC_MM_STORE_U64
 #define PPC_MM_STORE_U64(x, y)  PPC_STORE_U64(x, y)
 #endif
