+// R-comp's guest RAM is CPU-coherent and is copied into Vulkan resources.
+// dcbst must still perform translation/protection as a byte load and order
+// the writeback before later runtime/device operations. No GPU cache alias
+// exists here; cache maintenance for Vulkan allocations belongs to the backend.
+#ifndef PPC_DCBST
+#define PPC_DCBST(ea) do { (void)PPC_LOAD_U8(uint32_t(ea)); __atomic_thread_fence(__ATOMIC_SEQ_CST); } while (0)
+#endif
+
