-        setcsr(csr);
+        constexpr uint32_t invalidCauses = 0x01F80700;
+        csr = (csr & ~0x20000000u) | ((csr & invalidCauses) ? 0x20000000u : 0);
+        const bool enabled = ((csr & 0x20000000u) && (csr & 0x80)) ||
+            ((csr & 0x10000000u) && (csr & 0x40)) || ((csr & 0x08000000u) && (csr & 0x20)) ||
+            ((csr & 0x04000000u) && (csr & 0x10)) || ((csr & 0x02000000u) && (csr & 0x08));
+        csr = (csr & ~0x40000000u) | (enabled ? 0x40000000u : 0);
+    }
+
+    inline void storeFromGuest(uint32_t value, uint32_t fields = 0xFF) noexcept
+    {
+        uint32_t mask = 0;
+        for (unsigned i = 0; i < 8; ++i)
+            if (fields & (1u << i)) mask |= 0xFu << (4 * i);
+        csr = (csr & ~mask) | (value & mask);
+        csr &= ~0x00000800u; // reserved FPSCR bit 20
+        updateSummaries();
+        const uint32_t host = (getcsr() & ~RoundMask) | GuestToHost[csr & PPC_ROUND_MASK];
+        setcsr(host);
+    }
+
+    inline void copyToCR1(PPCCRRegister& cr1) const noexcept
+    {
+        cr1.lt = (csr >> 31) & 1; // FX
+        cr1.gt = (csr >> 30) & 1; // FEX
+        cr1.eq = (csr >> 29) & 1; // VX
+        cr1.so = (csr >> 28) & 1; // OX
+    }
+
+    inline uint64_t reciprocalSqrtEstimate(uint64_t input, uint64_t oldResult) noexcept
+    {
+        constexpr uint64_t sign = 0x8000000000000000ull;
+        constexpr uint64_t exponent = 0x7FF0000000000000ull;
+        constexpr uint64_t fraction = 0x000FFFFFFFFFFFFFull;
+        constexpr uint64_t quiet = 0x0008000000000000ull;
+        const uint64_t magnitude = input & ~sign;
+        uint64_t result;
+        uint32_t exception = 0;
+        if ((input & exponent) == exponent && (input & fraction)) {
+            result = input | quiet;
+            if (!(input & quiet)) exception = 0x01000000u; // VXSNAN
+        } else if (magnitude == 0) {
+            result = (input & sign) | exponent;
+            exception = 0x04000000u; // ZX (both signs of zero)
+        } else if (input & sign) {
+            result = exponent | quiet;
+            exception = 0x00000200u; // VXSQRT
+        } else if (magnitude == exponent) {
+            result = 0;
+        } else {
+            double value, estimate;
+            memcpy(&value, &input, sizeof value);
+            // An ISA-conforming estimate, not a bit-exact Xenon lookup table.
+            // Positive finite binary64 inputs cannot underflow/overflow here.
+            estimate = 1.0 / std::sqrt(value);
+            memcpy(&result, &estimate, sizeof result);
+        }
+        if (exception & ~csr) csr |= 0x80000000u; // FX on newly raised cause
+        csr |= exception;
