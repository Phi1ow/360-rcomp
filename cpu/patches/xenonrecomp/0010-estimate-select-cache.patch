+        if (absResult > exponent) classification = 0x11; // QNaN
+        else if (absResult == exponent) classification = (result & sign) ? 0x09 : 0x05;
+        else if (absResult == 0) classification = (result & sign) ? 0x12 : 0x02;
+        else classification = (result & sign) ? 0x08 : 0x04;
+        csr = (csr & ~0x0001F000u) | (classification << 12);
+        return result;
+    }
+
+    inline bool reciprocalSqrtRaisesEnabled(uint64_t input) const noexcept
+    {
+        const uint64_t magnitude = input & 0x7FFFFFFFFFFFFFFFull;
+        const bool nan = magnitude > 0x7FF0000000000000ull;
+        if (magnitude == 0) return (csr & 0x10) != 0;
+        const bool invalid = nan ? !(input & 0x0008000000000000ull) : (input >> 63) != 0;
+        return invalid && (csr & 0x80);
     }
 
