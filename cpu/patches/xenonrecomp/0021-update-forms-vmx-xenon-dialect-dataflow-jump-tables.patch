+// ---- R-comp patch 0021: jump tables found by data flow ------------------------
+// The four instruction patterns below only match one schedule of each table
+// form. Other compilers interleave the same instructions differently (lis,
+// rlwinm, addi, lwzx) or pad them with nops, and those tables were not found:
+// their bctr became an indirect call and the code after the inline table was cut
+// from the function. This recogniser starts from each bctr no pattern claimed and
+// follows the registers back through its straight-line run instead.
+namespace dataflow
+{
+constexpr uint32_t kBctr = 0x4E800420;
+constexpr uint32_t kBlr = 0x4E800020;
+
+inline uint32_t Op(uint32_t w) { return w >> 26; }
+inline uint32_t Rt(uint32_t w) { return (w >> 21) & 31; }
+inline uint32_t Ra(uint32_t w) { return (w >> 16) & 31; }
+inline uint32_t Rb(uint32_t w) { return (w >> 11) & 31; }
+inline uint32_t Xo(uint32_t w) { return (w >> 1) & 0x3FF; }
+inline int32_t Simm(uint32_t w) { return int16_t(w & 0xFFFF); }
+
+// A branch, sc or a zero word ends a straight-line run.
+inline bool EndsRun(uint32_t w)
+{
+    const uint32_t op = Op(w);
+    return w == 0 || op == 16 || op == 17 || op == 18 || (op == 19 && (Xo(w) == 16 || Xo(w) == 528));
+}
+
+inline bool IsMtctr(uint32_t w) { return (w & 0xFC1FFFFF) == 0x7C0903A6; }
+
+// GPRs `w` may write. Every bit when the form is not known, so a caller that
+// asks "is this register still intact" stays conservative.
+uint32_t GprWrites(uint32_t w)
+{
+    const uint32_t op = Op(w), rt = 1u << Rt(w), ra = 1u << Ra(w);
+    if (w == 0x60000000)
+        return 0;  // nop (ori r0,r0,0) leaves r0 unchanged; schedulers pad tables with it
+    switch (op)
+    {
+    case 7: case 8: case 12: case 13: case 14: case 15:  // mulli subfic addic addic. addi addis
+    case 32: case 34: case 40: case 42:                  // lwz lbz lhz lha
+        return rt;
+    case 58:                                             // ld ldu lwa
+        return (w & 3) == 1 ? rt | ra : rt;
+    case 33: case 35: case 41: case 43:                  // lwzu lbzu lhzu lhau
+        return rt | ra;
+    case 46:                                             // lmw rT..r31
+        return ~0u << Rt(w);
+    case 20: case 21: case 23: case 24: case 25: case 26: case 27: case 28: case 29: case 30:
+        return ra;                                       // rotates, logical immediates
+    case 36: case 38: case 44: case 47: case 48: case 50: case 52: case 54:
+        return 0;                                        // stw stb sth stmw lfs lfd stfs stfd
+    case 37: case 39: case 45: case 49: case 51: case 53: case 55:
+        return ra;                                       // update stores, update FP accesses
+    case 62:
+        return (w & 3) == 1 ? ra : 0;                    // std stdu
+    case 2: case 3: case 4: case 5: case 6: case 10: case 11: case 59: case 63:
+        return 0;                                        // traps, compares, VMX, FP
+    case 16: case 18:
+        return 0;                                        // branches (a call's clobbers are the caller's concern)
+    case 19:
+        return 0;                                        // CR logic, isync, bclr, bcctr
+    case 31:
+        switch (Xo(w))
+        {
+        case 0: case 32: case 4: case 68: case 54: case 86: case 246: case 278: case 470: case 982: case 1014:
+        case 598: case 854: case 467: case 144: case 146: case 178:
+        case 135: case 149: case 150: case 151: case 167: case 199: case 214: case 215: case 231: case 407:
+        case 487: case 647: case 662: case 663: case 679: case 727: case 903: case 918: case 935: case 983:
+        case 6: case 7: case 38: case 39: case 71: case 103: case 359: case 519: case 551: case 775: case 807:
+            return 0;                                    // compares, cache ops, stores, VMX loads, mtspr
+        case 181: case 183: case 247: case 439: case 567: case 631: case 695: case 759:
+            return ra;                                   // update stores, update FP loads
+        case 53: case 55: case 119: case 311: case 373: case 375:
+            return rt | ra;                              // update loads
+        case 24: case 26: case 27: case 28: case 58: case 60: case 122: case 124: case 284: case 316:
+        case 412: case 444: case 476: case 536: case 539: case 792: case 794: case 824: case 826: case 827:
+        case 922: case 954: case 986:
+            return ra;                                   // logical, shifts, counts, extends (rA)
+        default:
+            return rt;                                   // loads, arithmetic, mf*: rT
+        }
+    default:
+        return ~0u;
+    }
+}
+
+// CR fields (bit f = crf) `w` may write. Every bit when the form is not known.
+uint32_t CrWrites(uint32_t w)
+{
+    const uint32_t op = Op(w);
+    switch (op)
+    {
+    case 10: case 11:
+        return 1u << (Rt(w) >> 2);
+    case 13: case 28: case 29:
+        return 1;                                        // addic. andi. andis.
+    case 20: case 21: case 23: case 30:
+        return (w & 1) ? 1 : 0;
+    case 31:
+    {
+        const uint32_t xo = Xo(w);
+        if (xo == 0 || xo == 32 || xo == 512)
+            return 1u << (Rt(w) >> 2);                   // cmp cmpl mcrxr
+        if (xo == 144)
+        {
+            uint32_t mask = 0;
+            for (uint32_t f = 0; f < 8; f++)
+                if ((w >> 12) & (0x80u >> f))
+                    mask |= 1u << f;
+            return mask;                                 // mtcrf
+        }
+        return (w & 1) ? 1 : 0;                          // record forms, stwcx. stdcx.
+    }
+    case 19:
+        if (Xo(w) == 16 || Xo(w) == 528 || Xo(w) == 150)
+            return 0;
+        return 1u << (Rt(w) >> 2);                       // CR logic, mcrf
+    case 59:
+        return (w & 1) ? 2 : 0;
+    case 63:
+    {
+        const uint32_t xo = Xo(w);
+        if (xo == 0 || xo == 32 || xo == 64)
+            return 1u << (Rt(w) >> 2);                   // fcmpu fcmpo mcrfs
+        return (w & 1) ? 2 : 0;
+    }
+    case 4:
+        switch (w & 0x3FF)
+        {
+        case 6: case 70: case 134: case 198: case 454: case 518: case 582: case 646: case 710:
+        case 774: case 838: case 902: case 966:
+            return (w & 0x400) ? 1u << 6 : 0;            // vcmp*. (VC form)
+        default:
+            return 0;
+        }
+    case 6:
+        return (w & 0x40) ? 1u << 6 : 0;                 // VMX128 compares with record bit (and a few others)
+    case 2: case 3: case 5: case 7: case 8: case 12: case 14: case 15: case 16: case 17: case 18:
+    case 24: case 25: case 26: case 27: case 62:
+        return 0;
+    default:
+        return (op >= 32 && op <= 58) ? 0 : ~0u;         // loads and stores
+    }
+}
+
+struct Run
+{
+    const uint32_t* words{};  // big-endian words of the section
+    size_t base{};            // address of words[0]
+    size_t begin{};           // first index of the straight-line run ending at the bctr
+    size_t bctr{};            // index of the bctr
+
+    uint32_t At(size_t i) const { return ByteSwap(words[i]); }
+    size_t Address(size_t i) const { return base + 4 * i; }
+
+    // Index of the last instruction before `before` that may write GPR `reg`, or -1.
+    ptrdiff_t Def(size_t before, uint32_t reg) const
+    {
+        for (size_t i = before; i-- > begin;)
+            if (GprWrites(At(i)) & (1u << reg))
+                return ptrdiff_t(i);
+        return -1;
+    }
+
+    // Value of `reg` before `before` when it is built from lis/addi/addis/ori
+    // constants only.
+    bool Constant(size_t before, uint32_t reg, uint32_t& value, int depth = 0) const
+    {
+        const ptrdiff_t d = Def(before, reg);
+        if (d < 0 || depth > 4)
+            return false;
+        const uint32_t w = At(size_t(d));
+        uint32_t source = 0;
+        switch (Op(w))
+        {
+        case 14:  // addi / li
+        case 15:  // addis / lis
+        {
+            if (Rt(w) != reg)
+                return false;
+            const uint32_t imm = Op(w) == 14 ? uint32_t(Simm(w)) : uint32_t(Simm(w)) << 16;
+            if (Ra(w) == 0)
+            {
+                value = imm;
+                return true;
+            }
+            if (!Constant(size_t(d), Ra(w), source, depth + 1))
+                return false;
+            value = source + imm;
+            return true;
+        }
+        case 24:  // ori
+            if (Ra(w) != reg || !Constant(size_t(d), Rt(w), source, depth + 1))
+                return false;
+            value = source | (w & 0xFFFF);
+            return true;
+        default:
+            return false;
+        }
+    }
+};
+
+// rlwinm rA, rS, sh, 0, 31 - sh (slwi): returns rS.
+inline bool IsShiftLeft(uint32_t w, uint32_t reg, uint32_t sh, uint32_t& source)
+{
+    if (Op(w) != 21 || Ra(w) != reg || (w & 1) || Rb(w) != sh || ((w >> 6) & 31) != 0 || ((w >> 1) & 31) != 31 - sh)
+        return false;
+    source = Rt(w);
+    return true;
+}
+
+// lbzx / lhzx / lwzx rT, rA, rB (no record bit): 87 / 279 / 23.
+inline bool IsIndexedLoad(uint32_t w, uint32_t xo, uint32_t reg)
+{
+    return Op(w) == 31 && Xo(w) == xo && !(w & 1) && Rt(w) == reg && Ra(w) != 0;
+}
+
+struct Recognised
+{
+    bool shaped{};          // a jump-table data flow ends in this bctr
+    uint32_t type{};        // SWITCH_*
+    uint32_t index{};       // index register
+    size_t use{};           // run index of the first instruction reading the index
+    uint32_t table{};       // address of the table data
+    uint32_t codeBase{};    // computed / offset forms: the address offsets are added to
+    uint32_t shift{};       // computed form: offset scale
+};
+
+Recognised Recognise(const Run& run)
+{
+    Recognised out{};
+    ptrdiff_t mt = -1;
+    for (size_t i = run.bctr; i-- > run.begin;)
+        if (IsMtctr(run.At(i)))
+        {
+            mt = ptrdiff_t(i);
+            break;
+        }
+    if (mt < 0)
+        return out;
+    const uint32_t target = Rt(run.At(size_t(mt)));
+    const ptrdiff_t d = run.Def(size_t(mt), target);
+    if (d < 0)
+        return out;
+    const uint32_t w = run.At(size_t(d));
+    if (Op(w) != 31 || (w & 1) || Rt(w) != target)
+        return out;
+    const uint32_t a = Ra(w), b = Rb(w);
+    if (Xo(w) == 23 && a != 0)  // lwzx: absolute table
+    {
+        for (int order = 0; order < 2 && !out.shaped; order++)
+        {
+            const uint32_t base = order ? b : a, scaled = order ? a : b;
+            uint32_t table = 0, index = 0;
+            const ptrdiff_t s = run.Def(size_t(d), scaled);
+            if (!run.Constant(size_t(d), base, table) || s < 0 || !IsShiftLeft(run.At(size_t(s)), scaled, 2, index))
+                continue;
+            out = { true, SWITCH_ABSOLUTE, index, size_t(s), table, 0, 0 };
+        }
+        return out;
+    }
+    if (Xo(w) != 266 || (w & 0x400))  // add (no OE)
+        return out;
+    for (int order = 0; order < 2 && !out.shaped; order++)
+    {
+        const uint32_t base = order ? b : a, offset = order ? a : b;
+        uint32_t codeBase = 0;
+        const ptrdiff_t o = run.Def(size_t(d), offset);
+        if (!run.Constant(size_t(d), base, codeBase) || o < 0)
+            continue;
+        uint32_t ow = run.At(size_t(o)), shift = 0, loaded = offset;
+        ptrdiff_t load = o;
+        for (uint32_t sh = 1; sh <= 4; sh++)
+        {
+            uint32_t source = 0;
+            if (IsShiftLeft(ow, offset, sh, source))
+            {
+                shift = sh;
+                loaded = source;
+                load = run.Def(size_t(o), source);
+                if (load < 0)
+                    break;
+                ow = run.At(size_t(load));
+                break;
+            }
+        }
+        if (load < 0)
+            continue;
+        const bool bytes = IsIndexedLoad(ow, 87, loaded), halves = !shift && IsIndexedLoad(ow, 279, loaded);
+        if (!bytes && !halves)
+            continue;
+        for (int inner = 0; inner < 2 && !out.shaped; inner++)
+        {
+            const uint32_t tableReg = inner ? Rb(ow) : Ra(ow), indexReg = inner ? Ra(ow) : Rb(ow);
+            uint32_t table = 0;
+            // rA = 0 reads as the value 0, not r0: only rB may name r0.
+            if ((inner ? indexReg : tableReg) == 0 || !run.Constant(size_t(load), tableReg, table))
+                continue;
+            if (bytes)
+            {
+                out = { true, uint32_t(shift ? SWITCH_COMPUTED : SWITCH_BYTEOFFSET), indexReg, size_t(load), table, codeBase, shift };
+            }
+            else
+            {
+                uint32_t index = 0;
+                const ptrdiff_t s = run.Def(size_t(load), indexReg);
+                if (s < 0 || !IsShiftLeft(run.At(size_t(s)), indexReg, 1, index))
+                    continue;
+                out = { true, SWITCH_SHORTOFFSET, index, size_t(s), table, codeBase, 0 };
+            }
+        }
+    }
+    return out;
+}
+
+struct Guard
+{
+    bool found{};
+    uint32_t count{};
+    size_t defaultLabel{};
+};
+
+// The bound of `index`, searched backwards from the bctr: the nearest bgt/ble
+// (or bgtlr/blelr) on the gt bit of a field, or bge/blt (bgelr/bltlr) on its lt
+// bit, then the nearest write of that field, which must be `cmplwi crX, reg, N`
+// with `reg` holding the index: the index register itself, or the register it
+// was copied from (`mr index, reg`, the last write of the index before its
+// use). The search stops where that value may change (a write, or a call when
+// it is in a volatile register), at the end of the code that falls into the
+// table (blr, bctr, an unconditional branch other than one the preceding
+// conditional branch jumps over, sc, a zero word), and after 1,024
+// instructions. `useIndex` is the first instruction that reads the index;
+// writes after it do not stop the search.
+Guard FindGuard(const uint32_t* words, size_t sectionBase, size_t bctrIndex, uint32_t index, size_t useIndex)
+{
+    Guard out{};
+    auto ends = [](uint32_t w)
+        {
+            const uint32_t op = Op(w);
+            return w == 0 || w == kBlr || w == kBctr || op == 17 || (op == 18 && !(w & 1));
+        };
+    auto writes = [&](size_t k, uint32_t reg) { return (GprWrites(ByteSwap(words[k])) & (1u << reg)) != 0; };
+    // Between the first read of the index and the bctr the register may be reused:
+    // a compare there only bounds the index before its first write after the use.
+    size_t firstWrite = bctrIndex;
+    for (size_t k = useIndex; k < bctrIndex && firstWrite == bctrIndex; k++)
+        if (writes(k, index))
+            firstWrite = k;
+    // The last write of the index before its use, when it is `mr index, source`.
+    size_t copyAt = SIZE_MAX;
+    uint32_t source = index;
+    for (size_t k = useIndex; k-- > 0 && useIndex - k <= 1024;)
+    {
+        const uint32_t w = ByteSwap(words[k]);
+        if (ends(w))
+            break;
+        if (writes(k, index))
+        {
+            if (Op(w) == 31 && Xo(w) == 444 && !(w & 1) && Ra(w) == index && Rt(w) == Rb(w) && Rt(w) != index)
+            {
+                copyAt = k;
+                source = Rt(w);
+            }
+            break;
+        }
+    }
+    // After the copy, `source` keeps the index value until its next write.
+    size_t sourceFirstWrite = useIndex;
+    if (copyAt != SIZE_MAX)
+        for (size_t k = copyAt + 1; k < useIndex && sourceFirstWrite == useIndex; k++)
+            if (writes(k, source))
+                sourceFirstWrite = k;
+    int cr = -1;
+    bool exclusive = false;
+    auto isVolatile = [](uint32_t reg) { return reg == 0 || (reg >= 3 && reg <= 12); };
+    for (size_t step = 1; step <= 1024 && step <= bctrIndex; step++)
+    {
+        const size_t i = bctrIndex - step;
+        const size_t at = sectionBase + 4 * i;
+        const uint32_t w = ByteSwap(words[i]);
+        const uint32_t op = Op(w);
+        // The register that holds the index value at this point.
+        const uint32_t holder = copyAt != SIZE_MAX && i < copyAt ? source : index;
+        // `ble crX, L; b default; L:` reaches the code after the `b` through the
+        // conditional branch just before it: keep searching there.
+        const bool skipped = op == 18 && !(w & 3) && i > 0 && cr < 0 && Op(ByteSwap(words[i - 1])) == 16 &&
+            !(ByteSwap(words[i - 1]) & 3) && at - 4 + int32_t(int16_t(ByteSwap(words[i - 1]) & 0xFFFC)) == at + 4;
+        if (skipped)
+            continue;
+        if (ends(w))
+            break;
+        const bool call = (w & 1) && (op == 18 || op == 16 || (op == 19 && (Xo(w) == 16 || Xo(w) == 528)));
+        if (call && isVolatile(holder))
+            break;
+        if (cr < 0)
+        {
+            if ((op == 16 || (op == 19 && Xo(w) == 16)) && !(w & 1))
+            {
+                const uint32_t bo = Rt(w) & 0x1C, bi = Ra(w);
+                // bgt / ble on the gt bit (N + 1 cases), bge / blt on the lt bit (N cases).
+                if (((bi & 3) == 1 || (bi & 3) == 0) && (bo == 12 || bo == 4))
+                {
+                    cr = int(bi >> 2);
+                    exclusive = (bi & 3) == 0;
+                    const bool exits = (bi & 3) == 1 ? bo == 12 : bo == 4;
+                    if (op == 16 && exits && !(w & 2))
+                        out.defaultLabel = at + int32_t(int16_t(w & 0xFFFC));
+                    continue;
+                }
+            }
+        }
+        else if (CrWrites(w) & (1u << cr))
+        {
+            if (op == 10 && (Rt(w) >> 2) == uint32_t(cr) && !(Rt(w) & 1))
+            {
+                const uint32_t reg = Ra(w);
+                const bool onIndex = reg == index && (i >= useIndex ? i < firstWrite : copyAt == SIZE_MAX || i > copyAt);
+                const bool onSource = copyAt != SIZE_MAX && reg == source && i < useIndex &&
+                    (i < copyAt || i < sourceFirstWrite);
+                if (onIndex || onSource)
+                {
+                    out.count = (w & 0xFFFF) + (exclusive ? 0 : 1);
+                    out.found = out.count != 0;
+                }
+            }
+            break;
+        }
+        if (i < useIndex && i != copyAt && writes(i, holder))
+            break;
+    }
+    return out;
+}
+
+// Length of an absolute table emitted right after its bctr when no guard bounds
+// the index (it is bounded by construction). Entries are read while they are
+// aligned addresses after the entries read so far, at most 1 MiB past the table.
+// The table ends as soon as its smallest entry is the address just past it (the
+// first case follows the table; the patch 0015 rule), else at the first word
+// that cannot be an entry, provided no entry points inside the table. MSVC also
+// places code reached otherwise after a table, which the first rule alone missed.
+uint32_t InlineTableLength(const uint32_t* words, size_t available, uint32_t tableAddress)
+{
+    uint32_t lowest = UINT32_MAX;
+    uint32_t n = 0;
+    for (; n < 512 && n < available; n++)
+    {
+        const uint32_t entry = ByteSwap(words[n]);
+        if ((entry & 3) || entry < tableAddress + 4 * (n + 1) || entry - tableAddress > 0x100000)
+            break;
+        lowest = std::min(lowest, entry);
+        if (lowest == tableAddress + 4 * (n + 1))
+            return n + 1;
+    }
+    return n > 0 && lowest >= tableAddress + 4 * n ? n : 0;
+}
