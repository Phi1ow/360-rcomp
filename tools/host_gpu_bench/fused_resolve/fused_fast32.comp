#version 450
#extension GL_EXT_samplerless_texture_functions : require
// Fused render target dump + resolve copy for the 32-bit "fast" copy (resolve_fast_32bpp_1x2xmsaa_scaled_cs of the Xenos GPU subsystem): the copy shader of the SDK reads the EDRAM
// buffer that a dump pass has just filled from the host render target image; this shader reads the image itself and writes the destination in the one pass. The body after the
// EDRAM read is the verified transcription of the copy shader (host test: 300 random parameter sets on two GPUs, bit-identical destination); what replaces the EDRAM read is
// the dump shader's arithmetic run backwards: the EDRAM sample address -> the tile of the render target -> its pixel and sample -> the packed 32-bit value the dump would have
// stored there. Compile-time variant parameters (the caller prepends the #define lines):
//   SCALE_X, SCALE_Y   draw resolution scale
//   SRC_MSAA           guest MSAA of the render target: 0 = 1x, 1 = 2x, 2 = 4x
//   SRC_IS_DEPTH       1 = depth + stencil render target, 0 = color
//   SRC_KIND           color source kind: 1 = 8:8:8:8, 2 = 2:10:10:10, 3 = 2:10:10:10 float (7e3 from a half float image), 4 = 32-bit float bits
//   SRC_UINT           1 = the color image is sampled as unsigned integers (32-bit float kept as bits), 0 = as floats
//   DEPTH_FORMAT       0 = D24S8 (depth * 0xFFFFFF), 1 = D24FS8 (20e4 float)
//   DEPTH_ROUND        1 = round the 20e4 conversion to nearest even (device option depth_float24_round)
//   HOST_2X_SAMPLE_0, HOST_2X_SAMPLE_1   host sample index of guest samples 0 and 1 of a 2x surface
// Everything the dump shader does for these formats is reproduced; formats it handles that this does not (16-bit pairs, gamma as unorm16, 64-bit) are not variants.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
  uint edram_info;
  uint coordinate_info;
  uint dest_info;
  uint dest_coordinate_info;
  uint dest_base;            // unused: the scaled resolve destination is addressed relative to the bound range
  uint source_base_tiles;    // the render target's base tile
  uint source_pitch_tiles;   // the render target's pitch in tiles
  uint dispatch_first_tile;  // unused
} pc;

layout(std430, set = 0, binding = 0) writeonly buffer DestBuffer { uvec4 dest[]; };

#if SRC_MSAA == 0
#define SRC_TEXTURE_2D texture2D
#define USRC_TEXTURE_2D utexture2D
#define FETCH(tex, p, s) texelFetch(tex, p, 0)
#else
#define SRC_TEXTURE_2D texture2DMS
#define USRC_TEXTURE_2D utexture2DMS
#define FETCH(tex, p, s) texelFetch(tex, p, s)
#endif

#if SRC_IS_DEPTH
layout(set = 1, binding = 0) uniform SRC_TEXTURE_2D source_depth;
layout(set = 1, binding = 1) uniform USRC_TEXTURE_2D source_stencil;
#elif SRC_UINT
layout(set = 1, binding = 0) uniform USRC_TEXTURE_2D source_color;
#else
layout(set = 1, binding = 0) uniform SRC_TEXTURE_2D source_color;
#endif

// ---- the conversions of the dump shader (VulkanRenderTargetCache::GetDumpPipeline and SpirvShaderTranslator)

uint PreClampedFloat32To7e3(float f32) {
  uint bits = floatBitsToUint(f32);
  uint denormal_biased = bitfieldInsert(bits, 1u, 23, 9);
  denormal_biased >>= min(125u - (bits >> 23), 24u);
  uint normal_biased = bits - (124u << 23);
  uint biased = (bits < 0x3E800000u) ? denormal_biased : normal_biased;
  return bitfieldExtract(biased + 0x7FFFu + bitfieldExtract(biased, 16, 1), 16, 10);
}

uint UnclampedFloat32To7e3(float f32) {
  // NClamp(f32, 0, 31.875): a NaN becomes 0.
  float clamped = isnan(f32) ? 0.0 : min(max(f32, 0.0), 31.875);
  return PreClampedFloat32To7e3(clamped);
}

uint PreClampedDepthTo20e4(float f32) {
  // Round to nearest even or toward zero, the 0...1 depth remapped to 0...0.5 (remap bias 1).
  uint bits = floatBitsToUint(f32);
  uint denormal_biased = bitfieldInsert(bits, 1u, 23, 9);
  denormal_biased >>= min(112u - (bits >> 23), 24u);
  uint normal_biased = bits - (111u << 23);
  uint biased = (bits < 0x38000000u) ? denormal_biased : normal_biased;
#if DEPTH_ROUND
  biased += 3u + bitfieldExtract(biased, 3, 1);
#endif
  return bitfieldExtract(biased, 3, 24);
}

// The packed 32-bit EDRAM word of one sample of the render target.
uint PackedSample(ivec2 pixel, int sample_index) {
#if SRC_IS_DEPTH
  float depth = FETCH(source_depth, pixel, sample_index).x;
  uint stencil = FETCH(source_stencil, pixel, sample_index).x;
#if DEPTH_FORMAT == 0
  uint depth24 = uint(roundEven(depth * 16777215.0));
#else
  uint depth24 = PreClampedDepthTo20e4(depth);
#endif
  return bitfieldInsert(stencil, depth24, 8, 24);
#elif SRC_KIND == 1
  vec4 c = FETCH(source_color, pixel, sample_index);
  uvec4 u = uvec4(c * 255.0 + 0.5);
  return bitfieldInsert(bitfieldInsert(bitfieldInsert(u.x, u.y, 8, 8), u.z, 16, 8), u.w, 24, 8);
#elif SRC_KIND == 2
  vec4 c = FETCH(source_color, pixel, sample_index);
  uint r = uint(c.x * 1023.0 + 0.5), g = uint(c.y * 1023.0 + 0.5), b = uint(c.z * 1023.0 + 0.5), a = uint(c.w * 3.0 + 0.5);
  return bitfieldInsert(bitfieldInsert(bitfieldInsert(r, g, 10, 10), b, 20, 10), a, 30, 2);
#elif SRC_KIND == 3
  vec4 c = FETCH(source_color, pixel, sample_index);
  uint r = UnclampedFloat32To7e3(c.x), g = UnclampedFloat32To7e3(c.y), b = UnclampedFloat32To7e3(c.z);
  float alpha = isnan(c.w) ? 0.0 : min(max(c.w, 0.0), 1.0);
  uint a = uint(alpha * 3.0 + 0.5);
  return bitfieldInsert(bitfieldInsert(bitfieldInsert(r, g, 10, 10), b, 20, 10), a, 30, 2);
#else  // SRC_KIND == 4
#if SRC_UINT
  return FETCH(source_color, pixel, sample_index).x;
#else
  return floatBitsToUint(FETCH(source_color, pixel, sample_index).x);
#endif
#endif
}

// A sample of the render target in the sample space of its tiles (80x16 samples at 1x scale per tile), as the dump shader splits it into the pixel and the host sample.
uint PackedSampleAt(uint sample_x, uint sample_y) {
#if SRC_MSAA == 0
  return PackedSample(ivec2(int(sample_x), int(sample_y)), 0);
#elif SRC_MSAA == 1
  return PackedSample(ivec2(int(sample_x), int(sample_y >> 1)), (sample_y & 1u) != 0u ? HOST_2X_SAMPLE_1 : HOST_2X_SAMPLE_0);
#else
  return PackedSample(ivec2(int(sample_x >> 1), int(sample_y >> 1)), int((sample_x & 1u) | ((sample_y & 1u) << 1)));
#endif
}

// ---- the copy shader

uint TiledOffset2D(int x, int y, int pitch32) {
  int macro_tile = (x >> 5) + (y >> 5) * pitch32;
  int t = macro_tile << 9;
  int a = (x & 7) + ((y & 14) << 2);
  int b = a << 2;
  int c = (b & -16) << 1;
  int d = t + c + (b & 15);
  int e = d + ((y & 1) << 4);
  int f = ((e & -512) << 3) + ((y & 16) << 7) + ((e & 448) << 2);
  int g = f + ((((y & 8) >> 2) + (x >> 3)) & 3) * 64;
  return uint(g + (e & 63));
}

uint TiledOffset3D(ivec3 p, int pitch32, int height16) {
  int y16 = p.y >> 4;
  int z4 = p.z >> 2;
  int index = ((y16 + z4 * height16) * pitch32);
  int x32 = (p.x >> 5) + index;
  int a = (x32 << 8) & 0x0FFFFFFF;
  int a2 = a << 1;
  int b = (p.x & 7) + ((p.y & 6) << 2);
  int b2 = (b << 8) >> 6;
  int bank = ((p.y >> 3) + z4) & 1;
  int c = (p.x >> 3) + (bank << 1);
  int d = c & 3;
  int e = bank + (d << 1);
  int f = (b2 & -16) + a2;
  int g = (f << 1) + (b2 & 15);
  int h = g + ((p.z & 3) << 8) + ((p.y & 1) << 4);
  int pipe = ((e & 1) << 3) + ((h >> 6) & 7);
  int i = (((pipe << 3) + (e & -2)) << 2) + (h & -512);
  return uint((i << 3) + (h & 63));
}

uint Swap8In16(uint v) { return ((v & 0x00FF00FFu) << 8) | ((v & 0xFF00FF00u) >> 8); }
uint Swap16In32(uint v) { return (v << 16) | (v >> 16); }

void main() {
  uint c0 = pc.edram_info, c1 = pc.coordinate_info, c2 = pc.dest_info, c3 = pc.dest_coordinate_info;

  uint edram_pitch_tiles = c0 & 1023u;
  uint msaa = (c0 >> 10) & 3u;
  bool is_depth = (c0 & 4096u) != 0u;
  uint edram_base_tiles = (c0 >> 13) & 2047u;
  uint format = (c0 >> 24) & 15u;
  bool duplicate_second_pixel = (c0 & 0x20000000u) != 0u;

  uvec2 scale = (uvec2(c1) >> uvec2(16u, 19u)) & uvec2(7u);
  uvec2 duplicate = duplicate_second_pixel ? (scale >> 1u) : uvec2(0u);
  uvec2 region_offset = ((uvec2(c1) >> uvec2(0u, 4u)) & uvec2(15u, 1u)) << 3u;
  uvec2 region_offset_scaled = region_offset * scale;
  uint width_threads = ((c1 >> 5u) & 2047u) * scale.x;

  uint endian = c2 & 7u;
  bool is_3d = (c2 & 8u) != 0u;
  uint slice = (c2 >> 4u) & 7u;
  bool swap_red_blue = (c2 & 0x1000000u) != 0u;

  uint pitch_texels = (c3 & 1023u) << 5u;
  uint height_texels = ((c3 >> 10u) & 1023u) << 5u;
  uvec2 dest_offset_scaled = (((uvec2(c3) >> uvec2(20u, 24u)) & uvec2(15u)) << 3u) * scale;
  uint sample_select = (c3 >> 28u) & 7u;

  uint thread_x = gl_GlobalInvocationID.x;
  if (thread_x >= width_threads) {
    return;
  }

  uvec2 sample_xy = uvec2(gl_GlobalInvocationID.xy) << uvec2(3u, 0u);
  uvec2 position = uvec2(sample_xy.x, max(sample_xy.y, duplicate.y)) + region_offset_scaled;

  uint sample_index;
  if (sample_select <= 3u) {
    sample_index = sample_select;
  } else {
    sample_index = (sample_select == 5u) ? 2u : 0u;
  }
  uvec2 msaa_shift = uvec2(msaa >= 2u ? 1u : 0u, msaa >= 1u ? 1u : 0u);
  uvec2 sample_position = (position << msaa_shift) + ((uvec2(sample_index) >> uvec2(1u, 0u)) & uvec2(1u));

  const uint tile_width = 80u * uint(SCALE_X);
  const uint tile_height = 16u * uint(SCALE_Y);
  uvec2 tile_dims = uvec2(tile_width, tile_height);
  uvec2 tile = sample_position / tile_dims;
  uint tile_number = edram_base_tiles + tile.y * edram_pitch_tiles + tile.x;
  uvec2 in_tile = sample_position - tile * tile_dims;

  // The copy reads two groups of four EDRAM words: the aligned group that holds its column (the low two bits of a column that a sample select of 2 or 3 offsets by one are dropped by
  // the original's word index) and the next one, so eight columns from one tile of the render target (a group never straddles the half of the depth row, 40 columns times the scale).
  // The depth halves of the row are swapped once by the dump when it stores and once by the copy when it loads, so the render target is read at the copy's own column unless the
  // render target and the copy disagree about depth.
  uint half_width = tile_width >> 1u;
  uint x_edram = is_depth ? uint(int(in_tile.x) + (in_tile.x >= half_width ? -int(half_width) : int(half_width))) : in_tile.x;
  x_edram &= ~3u;
  uint x_source = (SRC_IS_DEPTH != 0) ? uint(int(x_edram) + (x_edram >= half_width ? -int(half_width) : int(half_width))) : x_edram;
  uint source_tile_index = tile_number - pc.source_base_tiles;
  uint source_tile_y = source_tile_index / pc.source_pitch_tiles;
  uint source_tile_x = source_tile_index - source_tile_y * pc.source_pitch_tiles;
  uint source_sample_x = tile_width * source_tile_x + x_source;
  uint source_sample_y = tile_height * source_tile_y + in_tile.y;
  uvec4 first = uvec4(PackedSampleAt(source_sample_x + 0u, source_sample_y), PackedSampleAt(source_sample_x + 1u, source_sample_y),
                      PackedSampleAt(source_sample_x + 2u, source_sample_y), PackedSampleAt(source_sample_x + 3u, source_sample_y));
  uvec4 second = uvec4(PackedSampleAt(source_sample_x + 4u, source_sample_y), PackedSampleAt(source_sample_x + 5u, source_sample_y),
                       PackedSampleAt(source_sample_x + 6u, source_sample_y), PackedSampleAt(source_sample_x + 7u, source_sample_y));

  if (sample_xy.x == 0u && duplicate.x != 0u) {
    if (duplicate.x >= 2u) {
      if (duplicate.x >= 3u) {
        first.z = first.w;
      }
      first.y = first.z;
    }
    first.x = first.y;
  }

  if (swap_red_blue) {
    if (format == 0u || format == 1u) {
      first = (first & 0xFF00FF00u) | ((first & 255u) << 16u) | ((first >> 16u) & 255u);
      second = (second & 0xFF00FF00u) | ((second & 255u) << 16u) | ((second >> 16u) & 255u);
    } else if (format == 2u || format == 3u || format == 10u || format == 12u) {
      first = (first & 0xC00FFC00u) | ((first & 1023u) << 20u) | ((first >> 20u) & 1023u);
      second = (second & 0xC00FFC00u) | ((second & 1023u) << 20u) | ((second >> 20u) & 1023u);
    }
  }

  uvec2 dest_position = sample_xy + dest_offset_scaled;
  uint dest_x4 = dest_position.x >> 2u;
  uvec2 guest = uvec2(dest_x4, dest_position.y) / scale;
  uint guest_x = guest.x << 2u;
  uint guest_y = guest.y;
  uint tiled;
  if (!is_3d) {
    tiled = TiledOffset2D(int(guest_x), int(guest_y), int(pitch_texels >> 5u));
  } else {
    tiled = TiledOffset3D(ivec3(int(guest_x), int(guest_y), int(slice)), int(pitch_texels >> 5u), int(height_texels >> 4u));
  }
  uvec2 remainder = uvec2(dest_x4, dest_position.y) - guest * scale;
  uint block = scale.x * scale.y;
  uint within = ((remainder.x * scale.y + remainder.y) << 2u) + (dest_position.x & 3u);
  uint byte_offset = tiled * block + (within << 2u);
  uint first_index = byte_offset >> 4u;

  uint second_step;
  if (scale.x > 1u) {
    uint x4 = sample_xy.x >> 2u;
    uint x4_remainder = x4 - (x4 / scale.x) * scale.x;
    second_step = (x4_remainder + 1u == scale.x) ? (32u * scale.x - (x4_remainder << 4u)) : 16u;
  } else {
    second_step = 32u;
  }
  uint second_index = first_index + ((second_step * scale.y) >> 4u);

  if (endian == 1u || endian == 2u) {
    first = uvec4(Swap8In16(first.x), Swap8In16(first.y), Swap8In16(first.z), Swap8In16(first.w));
    second = uvec4(Swap8In16(second.x), Swap8In16(second.y), Swap8In16(second.z), Swap8In16(second.w));
  }
  if (endian == 2u || endian == 3u) {
    first = uvec4(Swap16In32(first.x), Swap16In32(first.y), Swap16In32(first.z), Swap16In32(first.w));
    second = uvec4(Swap16In32(second.x), Swap16In32(second.y), Swap16In32(second.z), Swap16In32(second.w));
  }
  dest[first_index] = first;
  dest[second_index] = second;
}
