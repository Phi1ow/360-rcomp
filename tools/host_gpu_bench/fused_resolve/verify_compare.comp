#version 450
// Verification of the fused resolve (rcomp_fused_resolve_verify): counts the words of the resolve's destination range that differ between what the original two-pass path wrote
// (the real destination) and what the fused pass wrote (the scratch copy). Per slot: results[2 * slot] = number of differing words, results[2 * slot + 1] = ~(lowest differing
// word index), 0 while nothing differs.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer RealDestination { uint real[]; };
layout(std430, set = 1, binding = 0) readonly buffer Scratch { uint scratch[]; };
layout(std430, set = 2, binding = 0) buffer Results { uint results[]; };
layout(push_constant) uniform PushConstants {
  uint words;
  uint word_offset;
  uint slot;
} pc;
void main() {
  uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * (4096u * 256u);
  if (i >= pc.words) {
    return;
  }
  uint index = pc.word_offset + i;
  if (real[index] != scratch[index]) {
    atomicAdd(results[pc.slot * 2u], 1u);
    atomicMax(results[pc.slot * 2u + 1u], ~index);
  }
}
