+/**
+ * R-comp patch 0003: what the command processor needs from its owner, so it
+ * can run without rexglue's GraphicsSystem and kernel (KernelState, XThread).
+ * rexglue's GraphicsSystem and R-comp's Xenos host both provide it.
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::memory {
+class Memory;
+}
+
+namespace rex::graphics {
+
+class RegisterFile;
+
+class GpuHost {
+ public:
+  virtual ~GpuHost() = default;
+  virtual memory::Memory* memory() const = 0;
+  virtual RegisterFile* register_file() = 0;
+  // Runs the title's graphics interrupt callback (source 0 = vblank,
+  // 1 = command stream interrupt); cpu 0xFFFFFFFF = any.
+  virtual void DispatchInterruptCallback(uint32_t source, uint32_t cpu) = 0;
+};
+
+}  // namespace rex::graphics
