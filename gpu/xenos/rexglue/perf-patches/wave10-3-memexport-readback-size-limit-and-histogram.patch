+uint32_t VulkanCommandProcessor::RcompMxSizeBucket(uint32_t bytes) {
+  // <=256, <=1K, <=4K, <=16K, <=64K, <=256K, <=1M, more.
+  uint32_t bucket = 0;
+  uint32_t limit = 256;
+  while (bucket + 1 < kRcompMxSizeBuckets && bytes > limit) {
+    ++bucket;
+    limit <<= 2;
+  }
+  return bucket;
+}
+
+void VulkanCommandProcessor::RcompMxNoteSize(uint32_t bucket, uint32_t bytes) {
+  RcompMxSizeStat& stat = rcomp_mx_sizes_[bucket];
+  ++stat.draws;
+  stat.bytes += bytes;
+  const uint32_t base = memexport_ranges_.front().base_address_dwords << 2;
+  auto it = stat.bases.find(base);
+  if (it != stat.bases.end()) {
+    ++it->second.first;
+    it->second.second = std::max(it->second.second, bytes);
+  } else if (stat.bases.size() < 4096) {
+    stat.bases.emplace(base, std::make_pair(uint64_t(1), bytes));
+  } else {
+    ++stat.bases_overflow;
+  }
+}
+
+void VulkanCommandProcessor::RcompMxMarkUnreadPages(uint32_t bucket) {
+  for (const draw_util::MemExportRange& range : memexport_ranges_) {
+    const uint64_t first = uint64_t(range.base_address_dwords) << 2;
+    if (!range.size_bytes || first >= SharedMemory::kBufferSize) {
+      continue;
+    }
+    const uint64_t last = std::min(first + range.size_bytes, uint64_t(SharedMemory::kBufferSize)) - 1;
+    for (uint64_t page = first >> 12; page <= (last >> 12); ++page) {
+      uint8_t& mark = rcomp_mx_page_bucket_[page];
+      if (!mark) {
+        ++rcomp_mx_unread_pages_;
+      }
+      mark = uint8_t(std::max(uint32_t(mark), bucket + 1));
+    }
+  }
+}
+
+void VulkanCommandProcessor::RcompMxSizeReport() {
+  static const char* const kBucketNames[kRcompMxSizeBuckets] = {"256", "1K", "4K", "16K", "64K", "256K", "1M", "more"};
+  const double frames = double(std::max<uint64_t>(frame_current_ - rcomp_mx_sizes_frame_, 1));
+  char line[1536];
+  int n = std::snprintf(line, sizeof(line),
+                        "RCOMP-MEMEXPORT-SIZES frame=%llu frames=%.0f max_bytes=%u (bucket<=size: draws/frame "
+                        "KB/frame distinct_bases cpu_written_unread_pages_total)",
+                        (unsigned long long)frame_current_, frames, rcomp_mx_max_bytes_);
+  for (uint32_t i = 0; i < kRcompMxSizeBuckets && n > 0 && n < int(sizeof(line)); ++i) {
+    const RcompMxSizeStat& stat = rcomp_mx_sizes_[i];
+    if (!stat.draws && !rcomp_mx_stats_.cpu_write_pages_by_bucket[i]) {
+      continue;
+    }
+    n += std::snprintf(line + n, sizeof(line) - n, " %s:%.1f/%.1f/%zu%s/%llu", kBucketNames[i], double(stat.draws) / frames,
+                       double(stat.bytes) / 1024.0 / frames, stat.bases.size(), stat.bases_overflow ? "+" : "",
+                       (unsigned long long)rcomp_mx_stats_.cpu_write_pages_by_bucket[i]);
+  }
+  std::fprintf(stderr, "%s\n", line);
+  // The exports of at most 4 KiB by base address (most frequent first): the candidates a CPU consumes.
+  std::vector<std::pair<uint64_t, std::pair<uint32_t, uint32_t>>> small;
+  for (uint32_t i = 0; i <= 2; ++i) {
+    for (const auto& base : rcomp_mx_sizes_[i].bases) {
+      small.push_back({base.second.first, {base.first, base.second.second}});
+    }
+  }
+  std::sort(small.begin(), small.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+  if (!small.empty()) {
+    n = std::snprintf(line, sizeof(line), "RCOMP-MEMEXPORT-SMALL frame=%llu (base:bytes:draws/frame)",
+                      (unsigned long long)frame_current_);
+    for (size_t i = 0; i < small.size() && i < 16 && n > 0 && n < int(sizeof(line)); ++i) {
+      n += std::snprintf(line + n, sizeof(line) - n, " 0x%08X:%u:%.2f", small[i].second.first, small[i].second.second,
+                         double(small[i].first) / frames);
+    }
+    std::fprintf(stderr, "%s\n", line);
+  }
+  for (RcompMxSizeStat& stat : rcomp_mx_sizes_) {
+    stat = RcompMxSizeStat();
+  }
+  rcomp_mx_sizes_frame_ = frame_current_;
+}
