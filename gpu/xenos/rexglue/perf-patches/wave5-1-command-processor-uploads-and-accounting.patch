+// The state bits of a draw run class (rcomp_pass::DrawRunClass): 1 reads a color target (blend or partial
+// write mask), 2 the pixel shader can discard, 4 no pixel shader, 8 writes depth.
+uint32_t RcompDrawStateBits(const RegisterFile& regs, const reg::RB_DEPTHCONTROL& depth_control,
+                            uint32_t color_mask, const VulkanShader* pixel_shader) {
+  uint32_t bits = 0;
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    const uint32_t write_mask = (color_mask >> (4 * i)) & 0xF;
+    if (!write_mask) continue;
+    if (write_mask != 0xF) bits |= 1;
+    const auto blend = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]);
+    const auto reads_destination = [](xenos::BlendFactor source, xenos::BlendFactor destination, xenos::BlendOp op) {
+      return op == xenos::BlendOp::kMin || op == xenos::BlendOp::kMax || destination != xenos::BlendFactor::kZero ||
+             source == xenos::BlendFactor::kDstColor || source == xenos::BlendFactor::kOneMinusDstColor ||
+             source == xenos::BlendFactor::kDstAlpha || source == xenos::BlendFactor::kOneMinusDstAlpha;
+    };
+    if (reads_destination(blend.color_srcblend, blend.color_destblend, blend.color_comb_fcn) ||
+        reads_destination(blend.alpha_srcblend, blend.alpha_destblend, blend.alpha_comb_fcn))
+      bits |= 1;
+  }
+  if (pixel_shader && pixel_shader->kills_pixels()) bits |= 2;
+  if (!pixel_shader) bits |= 4;
+  if (depth_control.z_enable && depth_control.z_write_enable) bits |= 8;
+  return bits;
