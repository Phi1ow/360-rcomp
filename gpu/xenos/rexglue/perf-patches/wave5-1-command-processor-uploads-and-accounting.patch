+namespace {
+// Copies the float constants selected by a 256-bit map (four 64-bit words) from the register file into the
+// mapped uniform buffer, consecutive constants (the common case: a shader uses c0...cN) in one copy each.
+// `first_register` is the register of the constant 0 (vertex or pixel stage); the map order is the buffer order.
+inline uint8_t* CopyFloatConstants(uint8_t* mapping, const uint64_t (&map)[4], const uint32_t* first_register) {
+  for (uint32_t word = 0; word < 4; ++word) {
+    uint64_t remaining = map[word];
+    const uint32_t* word_registers = first_register + (word << 8);
+    while (remaining) {
+      const uint32_t first = uint32_t(std::countr_zero(remaining));
+      const uint32_t run = uint32_t(std::countr_one(remaining >> first));
+      std::memcpy(mapping, word_registers + (first << 2), size_t(run) * sizeof(float) * 4);
+      mapping += size_t(run) * sizeof(float) * 4;
+      remaining = first + run >= 64 ? 0 : remaining & ~(((UINT64_C(1) << run) - 1) << first);
+    }
+  }
+  return mapping;
+}
