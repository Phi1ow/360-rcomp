+// A depth-only draw into a 1x surface at least 1024 pixels wide: the shadow map pass of the game (1280x1280 in GTA IV). The game draws the shadow
+// casters with the EDRAM mode kDepthOnly (the pixel shader is not used) and the alpha-tested ones with kColorDepth and a pixel shader that writes no color.
+bool VulkanCommandProcessor::IsShadowPassCandidate() {
+  const RegisterFile& regs = *register_file_;
+  const xenos::EdramMode edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (edram_mode != xenos::EdramMode::kColorDepth && edram_mode != xenos::EdramMode::kDepthOnly) {
+    return false;
+  }
+  const auto surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  if (surface_info.msaa_samples != xenos::MsaaSamples::k1X || surface_info.surface_pitch < 1024) {
+    return false;
+  }
+  // Depth only: no color target is written (the color mask after the pixel shader's outputs is applied: the guest leaves a non-zero mask for a
+  // draw into no color target), and nothing is exported to memory.
+  auto* vertex_shader = static_cast<VulkanShader*>(active_vertex_shader());
+  auto* pixel_shader = static_cast<VulkanShader*>(active_pixel_shader());
+  if (vertex_shader == nullptr) {
+    return false;
+  }
+  pipeline_cache_->AnalyzeShaderUcode(*vertex_shader);
+  if (vertex_shader->memexport_eM_written() != 0) {
+    return false;
+  }
+  if (edram_mode == xenos::EdramMode::kColorDepth && pixel_shader != nullptr) {
+    pipeline_cache_->AnalyzeShaderUcode(*pixel_shader);
+    if (pixel_shader->memexport_eM_written() != 0 ||
+        draw_util::GetNormalizedColorMask(regs, pixel_shader->writes_color_targets()) != 0) {
+      return false;
+    }
+  }
+  // The casters write depth: draws that only test it or only touch the stencil do not start a pass.
+  const auto depth_control = regs.Get<reg::RB_DEPTHCONTROL>();
+  return depth_control.z_enable && depth_control.z_write_enable;
+}
