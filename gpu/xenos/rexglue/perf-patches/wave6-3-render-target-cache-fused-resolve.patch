+  int b = (p.x & 7) + ((p.y & 6) << 2);
+  int b2 = (b << 8) >> 6;
+  int bank = ((p.y >> 3) + z4) & 1;
+  int c = (p.x >> 3) + (bank << 1);
+  int d = c & 3;
+  int e = bank + (d << 1);
+  int f = (b2 & -16) + a2;
+  int g = (f << 1) + (b2 & 15);
+  int h = g + ((p.z & 3) << 8) + ((p.y & 1) << 4);
