+uint TiledOffset2D(int x, int y, int pitch32) {
+  int macro_tile = (x >> 5) + (y >> 5) * pitch32;
+  int t = macro_tile << 9;
+  int a = (x & 7) + ((y & 14) << 2);
+  int b = a << 2;
+  int c = (b & -16) << 1;
