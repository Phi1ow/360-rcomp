+// ---- R-comp: fused dump + resolve copy (rcomp_fused_resolve) ----
+
+void VulkanRenderTargetCache::LogFusedStats() {
+  std::fprintf(stderr,
+               "RCOMP-FUSED-RESOLVE attempts=%llu fused=%llu verified=%llu verify_skipped=%llu verify_mismatched=%llu verify_words=%llu rejected: copy_shader=%llu not_scaled=%llu "
+               "wrap=%llu rectangles=%llu coverage=%llu render_target=%llu format=%llu pipeline=%llu\n",
+               (unsigned long long)fused_stats_.attempts, (unsigned long long)fused_stats_.fused, (unsigned long long)fused_stats_.verify_resolves,
+               (unsigned long long)fused_stats_.verify_skipped, (unsigned long long)fused_stats_.verify_mismatched, (unsigned long long)fused_stats_.verify_words,
+               (unsigned long long)fused_stats_.rejected[kFusedRejectCopyShader], (unsigned long long)fused_stats_.rejected[kFusedRejectNotScaled],
+               (unsigned long long)fused_stats_.rejected[kFusedRejectWrap], (unsigned long long)fused_stats_.rejected[kFusedRejectRectangles],
+               (unsigned long long)fused_stats_.rejected[kFusedRejectCoverage], (unsigned long long)fused_stats_.rejected[kFusedRejectRenderTarget],
+               (unsigned long long)fused_stats_.rejected[kFusedRejectFormat], (unsigned long long)fused_stats_.rejected[kFusedRejectPipeline]);
+}
+
+bool VulkanRenderTargetCache::PlanFusedResolve(const draw_util::ResolveInfo& resolve_info,
+                                               draw_util::ResolveCopyShaderIndex copy_shader,
+                                               FusedResolvePlan& plan_out) {
+  ++fused_stats_.attempts;
+  if ((fused_stats_.attempts & 0x3FFF) == 0) {
+    LogFusedStats();
+  }
+  auto reject = [&](FusedRejectReason reason) {
+    ++fused_stats_.rejected[reason];
+    static unsigned rejections_logged = 0;
+    if (rejections_logged < 24) {
+      ++rejections_logged;
+      static const char* const kReasonNames[kFusedRejectCount] = {"copy_shader", "not_scaled", "wrap", "rectangles", "coverage", "render_target", "format", "pipeline"};
+      std::fprintf(stderr, "RCOMP-FUSED-RESOLVE rejected: %s (copy shader %u)\n", kReasonNames[reason], unsigned(copy_shader));
+    }
+    return false;
+  };
+  // The fused shader replaces the 32-bit fast copy of 1x and 2x surfaces (the 4x copy and the conversions of the full copies are other shaders), at the scaled resolution (the
+  // destination of a scaled resolve is the scaled resolve buffer).
+  if (copy_shader != draw_util::ResolveCopyShaderIndex::kFast32bpp1x2xMSAA) {
+    return reject(kFusedRejectCopyShader);
+  }
+  if (!IsDrawResolutionScaled()) {
+    return reject(kFusedRejectNotScaled);
+  }
+  uint32_t span_base, span_row_length, span_rows, span_pitch;
+  resolve_info.GetCopyEdramTileSpan(span_base, span_row_length, span_rows, span_pitch);
+  if (!span_row_length || !span_rows || !span_pitch) {
+    return reject(kFusedRejectCoverage);
+  }
+  // No wrap of the EDRAM addressing: the render target's tile index is the span's tile index minus its base.
+  if (uint64_t(span_base) + uint64_t(span_rows - 1) * span_pitch + span_row_length > xenos::kEdramTileCount) {
+    return reject(kFusedRejectWrap);
+  }
+  // One render target must own every tile of the span, so that the dump would have written the whole span from that one image and nothing of the copy reads stale EDRAM data.
+  GetResolveCopyRectanglesToDump(span_base, span_row_length, span_rows, span_pitch, dump_rectangles_);
+  if (dump_rectangles_.size() != 1) {
+    return reject(kFusedRejectRectangles);
+  }
+  const ResolveCopyDumpRectangle& rectangle = dump_rectangles_[0];
+  if (rectangle.row_first != 0 || rectangle.rows != span_rows || rectangle.row_first_start != 0 ||
+      rectangle.row_last_end != span_row_length) {
+    return reject(kFusedRejectCoverage);
+  }
+  auto* render_target = static_cast<VulkanRenderTarget*>(rectangle.render_target);
+  if (!render_target) {
+    return reject(kFusedRejectRenderTarget);
+  }
+  const RenderTargetKey key = render_target->key();
+  const bool copying_depth = resolve_info.IsCopyingDepth();
+  const draw_util::ResolveEdramInfo edram_info =
+      copying_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+  // The render target and the copy must agree about depth and about the MSAA mode (the dump's sample mask is made for the copy's samples), the target be a 1x or 2x 32-bit one.
+  if (bool(key.is_depth) != copying_depth || uint32_t(key.msaa_samples) != uint32_t(edram_info.msaa_samples) ||
+      key.msaa_samples >= xenos::MsaaSamples::k4X || key.Is64bpp() || !key.GetPitchTiles()) {
+    return reject(kFusedRejectRenderTarget);
+  }
+  DumpPipelineKey pipeline_key;
+  pipeline_key.msaa_samples = key.msaa_samples;
+  pipeline_key.resource_format = key.resource_format;
+  pipeline_key.is_depth = key.is_depth;
+  bool unsupported = false;
+  VkPipeline pipeline = GetFusedResolvePipeline(pipeline_key, unsupported);
+  if (pipeline == VK_NULL_HANDLE) {
+    return reject(unsupported ? kFusedRejectFormat : kFusedRejectPipeline);
+  }
+  plan_out.render_target = render_target;
+  plan_out.pipeline = pipeline;
+  plan_out.source_base_tiles = key.base_tiles;
+  plan_out.source_pitch_tiles = key.GetPitchTiles();
+  plan_out.span_first_tile = span_base;
+  ++fused_stats_.fused;
+  return true;
+}
+
+VkPipeline VulkanRenderTargetCache::GetFusedResolvePipeline(DumpPipelineKey key, bool& unsupported_out) {
+  unsupported_out = false;
+  auto entry_it = fused_resolve_pipelines_.find(key);
+  if (entry_it != fused_resolve_pipelines_.end()) {
+    unsupported_out = entry_it->second.unsupported;
+    return entry_it->second.pipeline;
+  }
+  FusedPipelineEntry entry;
+  // The variants the fused shader reproduces and the host test covered (tools/host_gpu_bench/fused_resolve/fused_resolve_bench.cpp): 8:8:8:8, 2:10:10:10 float, 32-bit float, depth with 24-bit float.
+  uint32_t kind = 0, depth_format = 0;
+  bool source_is_uint = false;
+  if (key.is_depth) {
+    if (key.GetDepthFormat() == xenos::DepthRenderTargetFormat::kD24FS8) {
+      depth_format = 1;
+    } else {
+      entry.unsupported = true;
+    }
+  } else {
+    switch (key.GetColorFormat()) {
+      case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+        kind = 1;
+        break;
+      case xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT:
+      case xenos::ColorRenderTargetFormat::k_2_10_10_10_FLOAT_AS_16_16_16_16:
+        kind = 3;
+        break;
+      case xenos::ColorRenderTargetFormat::k_32_FLOAT:
+        kind = 4;
+        GetColorOwnershipTransferVulkanFormat(key.GetColorFormat(), key.msaa_samples, &source_is_uint);
+        break;
+      default:
+        entry.unsupported = true;
+        break;
+    }
+  }
+  if (!entry.unsupported) {
+    char defines[640];
+    std::snprintf(defines, sizeof defines,
+                  "#version 450\n#extension GL_EXT_samplerless_texture_functions : require\n#define SCALE_X %u\n#define SCALE_Y %u\n#define SRC_MSAA %u\n#define SRC_IS_DEPTH %u\n"
+                  "#define SRC_KIND %u\n#define SRC_UINT %u\n#define DEPTH_FORMAT %u\n#define DEPTH_ROUND %u\n#define HOST_2X_SAMPLE_0 %u\n#define HOST_2X_SAMPLE_1 %u\n",
+                  draw_resolution_scale_x(), draw_resolution_scale_y(), unsigned(key.msaa_samples), unsigned(key.is_depth), kind, unsigned(source_is_uint), depth_format,
+                  unsigned(depth_float24_round()),
+                  draw_util::GetD3D10SampleIndexForGuest2xMSAA(0, msaa_2x_attachments_supported_),
+                  draw_util::GetD3D10SampleIndexForGuest2xMSAA(1, msaa_2x_attachments_supported_));
+    std::string source = defines;
+    source += kRcompFusedResolveFast32Glsl;
+    std::vector<uint32_t> spirv;
+    std::string error;
+    if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, source, spirv, error)) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to compile the fused resolve shader: {}", error);
+    } else {
+      entry.pipeline = ui::vulkan::util::CreateComputePipeline(
+          command_processor_.GetVulkanDevice(),
+          key.is_depth ? direct_resolve_pipeline_layout_depth_ : direct_resolve_pipeline_layout_color_, spirv.data(),
+          sizeof(uint32_t) * spirv.size());
+      if (entry.pipeline == VK_NULL_HANDLE) {
+        REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the fused resolve pipeline");
+      } else {
+        std::fprintf(stderr, "RCOMP-FUSED-RESOLVE pipeline depth=%u format=%u msaa=%u kind=%u uint=%u words=%zu\n", unsigned(key.is_depth),
+                     unsigned(key.resource_format), unsigned(key.msaa_samples), kind, unsigned(source_is_uint), spirv.size());
+      }
+    }
+  }
+  fused_resolve_pipelines_.emplace(key, entry);
+  unsupported_out = entry.unsupported;
+  return entry.pipeline;
+}
+
+void VulkanRenderTargetCache::RecordFusedResolve(const FusedResolvePlan& plan, VkDescriptorSet descriptor_set_dest,
+                                                 const draw_util::ResolveCopyShaderConstants& copy_constants,
+                                                 uint32_t group_count_x, uint32_t group_count_y) {
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  VulkanRenderTarget& vulkan_rt = *plan.render_target;
+  const bool is_depth = vulkan_rt.key().is_depth;
+  const VkImageSubresourceRange subresource_range = ui::vulkan::util::InitializeSubresourceRange(
+      is_depth ? (VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT) : VK_IMAGE_ASPECT_COLOR_BIT);
+  // The render target is sampled by the compute shader, as the dump does.
+  command_processor_.PushImageMemoryBarrier(
+      vulkan_rt.image(), subresource_range, vulkan_rt.current_stage_mask(), VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+      vulkan_rt.current_access_mask(), VK_ACCESS_SHADER_READ_BIT, vulkan_rt.current_layout(),
+      VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  vulkan_rt.SetUsage(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+
+  command_processor_.BindExternalComputePipeline(plan.pipeline);
+  VkPipelineLayout pipeline_layout = is_depth ? direct_resolve_pipeline_layout_depth_ : direct_resolve_pipeline_layout_color_;
+  VkDescriptorSet descriptor_sets[2] = {descriptor_set_dest, vulkan_rt.GetDescriptorSetTransferSource()};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, pipeline_layout, 0, 2, descriptor_sets, 0, nullptr);
+  DirectResolvePushConstants push_constants;
+  push_constants.resolve.dest_relative = copy_constants.dest_relative;
+  push_constants.resolve.dest_base = 0;
+  push_constants.source_base_tiles = plan.source_base_tiles;
+  push_constants.source_pitch_tiles = plan.source_pitch_tiles;
+  push_constants.dispatch_first_tile = plan.span_first_tile;
+  command_buffer.CmdVkPushConstants(pipeline_layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push_constants), &push_constants);
+  command_processor_.SubmitBarriers(true);
+  command_buffer.CmdVkDispatch(group_count_x, group_count_y, 1);
+
+  if (early_rt_barrier_) {
+    // As after the dump: the render target goes back to its drawing layout at once.
+    VkPipelineStageFlags rt_dst_stage_mask;
+    VkAccessFlags rt_dst_access_mask;
+    VkImageLayout rt_new_layout;
+    VulkanRenderTarget::GetDrawUsage(is_depth, &rt_dst_stage_mask, &rt_dst_access_mask, &rt_new_layout);
+    command_processor_.PushImageMemoryBarrier(vulkan_rt.image(), subresource_range, vulkan_rt.current_stage_mask(), rt_dst_stage_mask,
+                                              vulkan_rt.current_access_mask(), rt_dst_access_mask, vulkan_rt.current_layout(), rt_new_layout);
+    vulkan_rt.SetUsage(rt_dst_stage_mask, rt_dst_access_mask, rt_new_layout);
+    command_processor_.SubmitBarriers(true);
+  }
+}
+
+bool VulkanRenderTargetCache::EnsureFusedVerifyResources() {
+  if (fused_verify_ready_) {
+    return true;
+  }
+  if (fused_verify_failed_) {
+    return false;
+  }
+  fused_verify_failed_ = true;
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const VkDeviceSize scratch_size = VkDeviceSize(256) << 20;
+  const VkDeviceSize results_size = VkDeviceSize(kFusedVerifySlots) * 2 * sizeof(uint32_t);
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(vulkan_device, scratch_size, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+                                                         ui::vulkan::util::MemoryPurpose::kDeviceLocal, fused_verify_scratch_,
+                                                         fused_verify_scratch_memory_)) {
+    REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the fused resolve verification scratch buffer");
+    return false;
+  }
+  fused_verify_scratch_size_ = std::min<VkDeviceSize>(scratch_size, vulkan_device->properties().maxStorageBufferRange);
+  uint32_t results_memory_type = 0;
+  if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(vulkan_device, results_size, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+                                                         ui::vulkan::util::MemoryPurpose::kReadback, fused_verify_results_,
+                                                         fused_verify_results_memory_, &results_memory_type,
+                                                         &fused_verify_results_memory_size_)) {
+    REXGPU_ERROR("VulkanRenderTargetCache: Failed to create the fused resolve verification results buffer");
+    return false;
+  }
+  void* mapping = nullptr;
+  if (dfn.vkMapMemory(device, fused_verify_results_memory_, 0, VK_WHOLE_SIZE, 0, &mapping) != VK_SUCCESS) {
+    REXGPU_ERROR("VulkanRenderTargetCache: Failed to map the fused resolve verification results buffer");
+    return false;
+  }
+  fused_verify_results_mapped_ = static_cast<uint32_t*>(mapping);
+  std::memset(mapping, 0, size_t(results_size));
+  fused_verify_results_coherent_ = (vulkan_device->memory_types().host_coherent & (uint32_t(1) << results_memory_type)) != 0;
+  if (!fused_verify_results_coherent_) {
+    VkMappedMemoryRange range = {};
+    range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    range.memory = fused_verify_results_memory_;
+    range.offset = 0;
+    range.size = std::min(rex::round_up(results_size, vulkan_device->properties().nonCoherentAtomSize), fused_verify_results_memory_size_);
+    dfn.vkFlushMappedMemoryRanges(device, 1, &range);
+  }
+
+  // The results descriptor (set 2 of the compare pipeline).
+  VkDescriptorPoolSize pool_size;
+  pool_size.type = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  pool_size.descriptorCount = 1;
+  VkDescriptorPoolCreateInfo pool_create_info = {VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+  pool_create_info.maxSets = 1;
+  pool_create_info.poolSizeCount = 1;
+  pool_create_info.pPoolSizes = &pool_size;
+  if (dfn.vkCreateDescriptorPool(device, &pool_create_info, nullptr, &fused_verify_pool_) != VK_SUCCESS) {
+    return false;
+  }
+  VkDescriptorSetAllocateInfo set_allocate_info = {VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+  set_allocate_info.descriptorPool = fused_verify_pool_;
+  set_allocate_info.descriptorSetCount = 1;
+  set_allocate_info.pSetLayouts = &descriptor_set_layout_storage_buffer_;
+  if (dfn.vkAllocateDescriptorSets(device, &set_allocate_info, &fused_verify_results_set_) != VK_SUCCESS) {
+    return false;
+  }
+  VkDescriptorBufferInfo results_buffer_info = {fused_verify_results_, 0, VK_WHOLE_SIZE};
+  VkWriteDescriptorSet results_write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+  results_write.dstSet = fused_verify_results_set_;
+  results_write.descriptorCount = 1;
+  results_write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  results_write.pBufferInfo = &results_buffer_info;
+  dfn.vkUpdateDescriptorSets(device, 1, &results_write, 0, nullptr);
+
+  // Pipeline layout: set 0 the real destination and set 1 the scratch (transient single-buffer sets), set 2 the results.
+  VkDescriptorSetLayout set_layouts[3] = {
+      command_processor_.GetSingleTransientDescriptorLayout(VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute),
+      command_processor_.GetSingleTransientDescriptorLayout(VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute),
+      descriptor_set_layout_storage_buffer_};
+  VkPushConstantRange push_range = {VK_SHADER_STAGE_COMPUTE_BIT, 0, 3 * sizeof(uint32_t)};
+  VkPipelineLayoutCreateInfo layout_create_info = {VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+  layout_create_info.setLayoutCount = 3;
+  layout_create_info.pSetLayouts = set_layouts;
+  layout_create_info.pushConstantRangeCount = 1;
+  layout_create_info.pPushConstantRanges = &push_range;
+  if (dfn.vkCreatePipelineLayout(device, &layout_create_info, nullptr, &fused_verify_pipeline_layout_) != VK_SUCCESS) {
+    return false;
+  }
+  std::vector<uint32_t> spirv;
+  std::string error;
+  for (int which = 0; which < 2; ++which) {
+    std::string source = which ? kRcompFusedVerifyCompareGlsl : kRcompFusedVerifySnapshotGlsl;
+    spirv.clear();
+    if (!command_processor_.CompileGlslToSpirv(VK_SHADER_STAGE_COMPUTE_BIT, source, spirv, error)) {
+      REXGPU_ERROR("VulkanRenderTargetCache: Failed to compile a fused resolve verification shader: {}", error);
+      return false;
+    }
+    VkPipeline pipeline = ui::vulkan::util::CreateComputePipeline(vulkan_device, fused_verify_pipeline_layout_, spirv.data(), sizeof(uint32_t) * spirv.size());
+    if (pipeline == VK_NULL_HANDLE) {
+      return false;
+    }
+    (which ? fused_verify_compare_pipeline_ : fused_verify_snapshot_pipeline_) = pipeline;
+  }
+  fused_verify_slot_info_.assign(kFusedVerifyInfoRing, FusedVerifySlotInfo());
+  fused_verify_ready_ = true;
+  fused_verify_failed_ = false;
+  std::fprintf(stderr, "RCOMP-FUSED-VERIFY ready scratch=%llu MB results=%u slots coherent=%u\n", (unsigned long long)(scratch_size >> 20), kFusedVerifySlots,
+               unsigned(fused_verify_results_coherent_));
+  return true;
+}
+
+bool VulkanRenderTargetCache::RecordFusedVerifyBegin(VulkanTextureCache& texture_cache, VkDescriptorSet descriptor_set_dest, uint64_t use_start,
+                                                     uint64_t use_length, uint64_t use_offset_in_binding, VkDescriptorSet& scratch_set_out,
+                                                     uint32_t& slot_out) {
+  if (!EnsureFusedVerifyResources() || !use_length) {
+    return false;
+  }
+  const uint64_t words = (use_length + 3) >> 2;
+  if (use_offset_in_binding + use_length > fused_verify_scratch_size_ || (use_offset_in_binding & 3) || fused_verify_next_slot_ >= kFusedVerifySlots) {
+    ++fused_stats_.verify_skipped;
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  // The scratch buffer as a second transient destination descriptor.
+  scratch_set_out = command_processor_.AllocateSingleTransientDescriptor(VulkanCommandProcessor::SingleTransientDescriptorLayout::kStorageBufferCompute);
+  if (scratch_set_out == VK_NULL_HANDLE) {
+    ++fused_stats_.verify_skipped;
+    return false;
+  }
+  VkDescriptorBufferInfo scratch_info;
+  scratch_info.buffer = fused_verify_scratch_;
+  scratch_info.offset = 0;
+  scratch_info.range = std::min<VkDeviceSize>(fused_verify_scratch_size_, vulkan_device->properties().maxStorageBufferRange);
+  VkWriteDescriptorSet scratch_write = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+  scratch_write.dstSet = scratch_set_out;
+  scratch_write.descriptorCount = 1;
+  scratch_write.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+  scratch_write.pBufferInfo = &scratch_info;
+  dfn.vkUpdateDescriptorSets(device, 1, &scratch_write, 0, nullptr);
+
+  slot_out = fused_verify_next_slot_++;
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  // The scratch buffer is only ever used by these compute passes: one conservative barrier before each of them.
+  const VkPipelineStageFlags compute_stage = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+  const VkAccessFlags compute_access = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+  command_processor_.PushBufferMemoryBarrier(fused_verify_scratch_, 0, VK_WHOLE_SIZE, compute_stage, compute_stage, compute_access, compute_access);
+  command_processor_.BindExternalComputePipeline(fused_verify_snapshot_pipeline_);
+  VkDescriptorSet sets[3] = {descriptor_set_dest, scratch_set_out, fused_verify_results_set_};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, fused_verify_pipeline_layout_, 0, 3, sets, 0, nullptr);
+  const uint32_t push[3] = {uint32_t(words), uint32_t(use_offset_in_binding >> 2), slot_out};
+  command_buffer.CmdVkPushConstants(fused_verify_pipeline_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push), push);
+  command_processor_.SubmitBarriers(true);
+  const uint32_t groups = uint32_t((words + 255) >> 8);
+  command_buffer.CmdVkDispatch(std::min<uint32_t>(groups, 4096), (groups + 4095) / 4096, 1);
+  // The resolve writes the destination next: the snapshot's reads must be over (write after read), which this call orders.
+  texture_cache.UseScaledResolveBufferForWrite(use_start, use_length);
+  return true;
+}
+
+void VulkanRenderTargetCache::RecordFusedVerifyEnd(VulkanTextureCache& texture_cache, const FusedResolvePlan& plan, VkDescriptorSet descriptor_set_dest,
+                                                   VkDescriptorSet scratch_set, const draw_util::ResolveCopyShaderConstants& copy_constants,
+                                                   uint32_t group_count_x, uint32_t group_count_y, uint64_t use_start, uint64_t use_length,
+                                                   uint64_t use_offset_in_binding, uint32_t slot) {
+  DeferredCommandBuffer& command_buffer = command_processor_.deferred_command_buffer();
+  const uint64_t words = (use_length + 3) >> 2;
+  const VkPipelineStageFlags compute_stage = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT;
+  const VkAccessFlags compute_access = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT;
+  // The fused pass writes the scratch copy of the destination (after the snapshot of it).
+  command_processor_.PushBufferMemoryBarrier(fused_verify_scratch_, 0, VK_WHOLE_SIZE, compute_stage, compute_stage, compute_access, compute_access);
+  RecordFusedResolve(plan, scratch_set, copy_constants, group_count_x, group_count_y);
+  // The original path's writes of the real destination and the fused pass's writes of the scratch buffer must be done before the comparison reads both.
+  texture_cache.UseScaledResolveBufferForWrite(use_start, use_length);
+  command_processor_.PushBufferMemoryBarrier(fused_verify_scratch_, 0, VK_WHOLE_SIZE, compute_stage, compute_stage, compute_access, compute_access);
+  command_processor_.BindExternalComputePipeline(fused_verify_compare_pipeline_);
+  VkDescriptorSet sets[3] = {descriptor_set_dest, scratch_set, fused_verify_results_set_};
+  command_buffer.CmdVkBindDescriptorSets(VK_PIPELINE_BIND_POINT_COMPUTE, fused_verify_pipeline_layout_, 0, 3, sets, 0, nullptr);
+  const uint32_t push[3] = {uint32_t(words), uint32_t(use_offset_in_binding >> 2), slot};
+  command_buffer.CmdVkPushConstants(fused_verify_pipeline_layout_, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(push), push);
+  command_processor_.SubmitBarriers(true);
+  const uint32_t groups = uint32_t((words + 255) >> 8);
+  command_buffer.CmdVkDispatch(std::min<uint32_t>(groups, 4096), (groups + 4095) / 4096, 1);
+  ++fused_stats_.verify_resolves;
+  fused_stats_.verify_words += words;
+  FusedVerifySlotInfo& info = fused_verify_slot_info_[slot % kFusedVerifyInfoRing];
+  info.frame = uint32_t(command_processor_.GetCurrentFrame());
+  info.render_target_key = plan.render_target->key().key;
+  info.constants[0] = copy_constants.dest_relative.edram_info.packed;
+  info.constants[1] = copy_constants.dest_relative.coordinate_info.packed;
+  info.constants[2] = copy_constants.dest_relative.dest_info.value;
+  info.constants[3] = copy_constants.dest_relative.dest_coordinate_info.packed;
+  info.span_first_tile = plan.span_first_tile;
+  info.words = uint32_t(words);
+  // The results of the resolves that are surely complete (the last 2,048 are not read yet).
+  if ((slot & 1023) == 1023 && slot > 3072) {
+    ScanFusedVerifyResults(slot - 2048);
+  }
+}
+
+void VulkanRenderTargetCache::ScanFusedVerifyResults(uint32_t limit_slot) {
+  if (!fused_verify_results_mapped_) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = command_processor_.GetVulkanDevice();
+  if (!fused_verify_results_coherent_) {
+    VkMappedMemoryRange range = {};
+    range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+    range.memory = fused_verify_results_memory_;
+    range.offset = 0;
+    range.size = std::min(rex::round_up(VkDeviceSize(kFusedVerifySlots) * 2 * sizeof(uint32_t), vulkan_device->properties().nonCoherentAtomSize),
+                          fused_verify_results_memory_size_);
+    vulkan_device->functions().vkInvalidateMappedMemoryRanges(vulkan_device->device(), 1, &range);
+  }
+  uint32_t mismatched_in_scan = 0;
+  for (; fused_verify_scan_next_ < limit_slot && fused_verify_scan_next_ < fused_verify_next_slot_; ++fused_verify_scan_next_) {
+    const uint32_t slot = fused_verify_scan_next_;
+    const uint32_t differing = fused_verify_results_mapped_[2 * slot];
+    if (!differing) {
+      continue;
+    }
+    ++fused_stats_.verify_mismatched;
+    ++mismatched_in_scan;
+    if (fused_stats_.verify_mismatched <= 32) {
+      const FusedVerifySlotInfo& info = fused_verify_slot_info_[slot % kFusedVerifyInfoRing];
+      std::fprintf(stderr,
+                   "RCOMP-FUSED-VERIFY MISMATCH slot=%u frame=%u words=%u differing=%u first_word=%u rt=%08X span_first_tile=%u constants=%08X,%08X,%08X,%08X\n", slot,
+                   info.frame, info.words, differing, ~fused_verify_results_mapped_[2 * slot + 1], info.render_target_key, info.span_first_tile, info.constants[0],
+                   info.constants[1], info.constants[2], info.constants[3]);
+    }
+  }
+  std::fprintf(stderr, "RCOMP-FUSED-VERIFY scanned=%u verified=%llu mismatched=%llu words=%llu\n", fused_verify_scan_next_,
+               (unsigned long long)fused_stats_.verify_resolves, (unsigned long long)fused_stats_.verify_mismatched,
+               (unsigned long long)fused_stats_.verify_words);
+}
