+bool VulkanCommandProcessor::RcompMxRecord(uint32_t total_size) {
+  constexpr uint32_t kChunkSize = 4u << 20;
+  constexpr size_t kMaxChunks = 32;
+  constexpr uint32_t kAlignment = 256;
+  if (!total_size || total_size > kChunkSize || memexport_ranges_.empty()) {
+    return false;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  const uint32_t alignment =
+      std::max(kAlignment, uint32_t(std::min(vulkan_device->properties().nonCoherentAtomSize, VkDeviceSize(65536))));
+  const auto fits = [&](const RcompMxChunk& chunk) {
+    return rex::align(chunk.used, alignment) + uint64_t(total_size) <= kChunkSize;
+  };
+  if (rcomp_mx_chunks_.empty() || !fits(rcomp_mx_chunks_[rcomp_mx_chunk_current_])) {
+    bool found = false;
+    const size_t chunk_count = rcomp_mx_chunks_.size();
+    for (size_t step = 1; step <= chunk_count; ++step) {
+      const uint32_t i = uint32_t((rcomp_mx_chunk_current_ + step) % chunk_count);
+      if (!rcomp_mx_chunks_[i].pending) {
+        rcomp_mx_chunks_[i].used = 0;
+        rcomp_mx_chunk_current_ = i;
+        found = true;
+        break;
+      }
+    }
+    if (!found && chunk_count < kMaxChunks) {
+      RcompMxChunk chunk;
+      uint32_t memory_type = UINT32_MAX;
+      if (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+              vulkan_device, kChunkSize, VK_BUFFER_USAGE_TRANSFER_DST_BIT, ui::vulkan::util::MemoryPurpose::kReadback,
+              chunk.buffer, chunk.memory, &memory_type, &chunk.memory_size)) {
+        return false;
+      }
+      void* mapping = nullptr;
+      if (dfn.vkMapMemory(device, chunk.memory, 0, VK_WHOLE_SIZE, 0, &mapping) != VK_SUCCESS) {
+        dfn.vkDestroyBuffer(device, chunk.buffer, nullptr);
