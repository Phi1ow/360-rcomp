+void VulkanCommandProcessor::PrepareForWait() {
+  CommandProcessor::PrepareForWait();
+  // R-comp (wave 10): the command processor is about to idle or sleep: hand the completed memexport copies to the guest (no wait).
+  if (!rcomp_mx_pending_.empty()) {
+    CheckSubmissionFenceAndDeviceLoss(0);
