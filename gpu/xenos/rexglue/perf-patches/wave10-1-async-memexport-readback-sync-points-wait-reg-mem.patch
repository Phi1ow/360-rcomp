+      rcomp_mx_chunks_.push_back(chunk);
+      rcomp_mx_chunk_current_ = uint32_t(rcomp_mx_chunks_.size() - 1);
+      rcomp_mx_stats_.chunks = rcomp_mx_chunks_.size();
+      found = true;
+    }
+    if (!found) {
+      // Every chunk holds copies not yet retired: wait for them (this ends the submission that holds the draw).
+      RcompMxFlush(kRcompMxTriggerCapacity);
+      if (!rcomp_mx_pending_.empty() || !BeginSubmission(true)) {
+        return false;
+      }
+      rcomp_mx_chunk_current_ = 0;
+      rcomp_mx_chunks_[0].used = 0;
+    }
+  }
+  const uint32_t chunk_index = rcomp_mx_chunk_current_;
+  RcompMxChunk& chunk = rcomp_mx_chunks_[chunk_index];
+  const uint32_t offset = rex::align(chunk.used, alignment);
+  chunk.used = offset + total_size;
+
+  shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+  SubmitBarriers(true);
+  uint32_t copy_offset = offset;
+  for (const draw_util::MemExportRange& range : memexport_ranges_) {
+    VkBufferCopy region = {};
+    region.srcOffset = VkDeviceSize(range.base_address_dwords) << 2;
+    region.dstOffset = copy_offset;
+    region.size = range.size_bytes;
+    deferred_command_buffer_.CmdVkCopyBuffer(shared_memory_->buffer(), chunk.buffer, 1, &region);
+    copy_offset += range.size_bytes;
+    rcomp_mx_ranges_.push_back(range);
+    const uint32_t first = range.base_address_dwords << 2;
+    rcomp_mx_extent_first_ = std::min(rcomp_mx_extent_first_, first);
+    rcomp_mx_extent_last_ = std::max(rcomp_mx_extent_last_, first + std::max(range.size_bytes, 1u) - 1);
+  }
+  PushBufferMemoryBarrier(chunk.buffer, offset, total_size, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT,
+                          VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_HOST_READ_BIT);
+  rcomp_mx_pending_.push_back(
+      {GetCurrentSubmission(), frame_current_, chunk_index, offset, total_size, uint32_t(memexport_ranges_.size())});
+  ++chunk.pending;
+  ++rcomp_mx_stats_.draws;
+  rcomp_mx_stats_.bytes += total_size;
+  rcomp_mx_stats_.max_pending = std::max(rcomp_mx_stats_.max_pending, uint64_t(rcomp_mx_pending_.size()));
+  RcompMxUpdateArm();
+  return true;
+}
+
+void VulkanCommandProcessor::RcompMxRetireCompleted() {
+  if (rcomp_mx_retiring_) {
+    return;
+  }
+  rcomp_mx_retiring_ = true;
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  while (!rcomp_mx_pending_.empty() && rcomp_mx_pending_.front().submission <= submission_completed_) {
+    const RcompMxPending record = rcomp_mx_pending_.front();
+    RcompMxChunk& chunk = rcomp_mx_chunks_[record.chunk];
+    if (!chunk.coherent) {
+      const VkDeviceSize atom = std::max(vulkan_device->properties().nonCoherentAtomSize, VkDeviceSize(1));
+      VkMappedMemoryRange memory_range = {};
+      memory_range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+      memory_range.memory = chunk.memory;
+      memory_range.offset = VkDeviceSize(record.offset) / atom * atom;
+      memory_range.size =
+          std::min((VkDeviceSize(record.offset) + record.size + atom - 1) / atom * atom, chunk.memory_size) -
+          memory_range.offset;
+      vulkan_device->functions().vkInvalidateMappedMemoryRanges(vulkan_device->device(), 1, &memory_range);
+    }
+    // The GPU's copy of these bytes is the data itself (the draw wrote it there): no CPU write is noted, so the
+    // GPU does not upload over newer memexport results of later draws.
+    const uint8_t* source = chunk.mapping + record.offset;
+    for (uint32_t i = 0; i < record.range_count; ++i) {
+      const draw_util::MemExportRange range = rcomp_mx_ranges_.front();
+      rcomp_mx_ranges_.pop_front();
+      std::memcpy(memory_->TranslatePhysical(range.base_address_dwords << 2), source, range.size_bytes);
+      source += range.size_bytes;
+    }
+    --chunk.pending;
+    rcomp_mx_stats_.lag_frames += frame_current_ - record.frame;
+    if (rcomp_mx_flushing_) {
+      ++rcomp_mx_stats_.retired_flushed;
+    } else {
+      ++rcomp_mx_stats_.retired_polled;
+    }
+    rcomp_mx_pending_.pop_front();
+  }
+  if (rcomp_mx_pending_.empty()) {
+    rcomp_mx_extent_first_ = UINT32_MAX;
+    rcomp_mx_extent_last_ = 0;
+    rcomp_mx_cpu_overlap_ = false;
+  }
+  rcomp_mx_retiring_ = false;
+  RcompMxUpdateArm();
+}
+
+void VulkanCommandProcessor::RcompMxFlush(RcompMxTrigger trigger) {
+  ++rcomp_mx_stats_.flushes[trigger];
+  if (rcomp_mx_pending_.empty()) {
+    return;
+  }
+  const uint64_t newest = rcomp_mx_pending_.back().submission;
+  rcomp_mx_flushing_ = true;
+  if (newest > submission_completed_) {
+    ++rcomp_mx_stats_.blocking[trigger];
+    const auto t0 = std::chrono::steady_clock::now();
+    // Ends the open submission when it holds the copies; retires what completed.
+    CheckSubmissionFenceAndDeviceLoss(newest);
+    rcomp_mx_stats_.blocking_us[trigger] +=
+        uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count());
+  }
+  RcompMxRetireCompleted();
+  rcomp_mx_flushing_ = false;
+}
+
+void VulkanCommandProcessor::RcompMxReport() {
+  const RcompMxStats& s = rcomp_mx_stats_;
+  if ((!rcomp_mx_mode_ && !s.sdk_fast_hits && !s.sdk_full_waits) || frame_current_ < rcomp_mx_last_report_frame_ + 300) {
+    return;
+  }
+  rcomp_mx_last_report_frame_ = frame_current_;
+  const uint64_t retired = s.retired_polled + s.retired_flushed;
+  std::fprintf(stderr,
+               "RCOMP-MEMEXPORT-RB frame=%llu mode=%d draws=%llu bytes=%llu retired_polled=%llu retired_flushed=%llu "
+               "avg_lag_frames=%.2f pending=%zu max_pending=%llu chunks=%llu sdk_fallbacks=%llu sdk_fast_hits=%llu "
+               "sdk_fast_to_full=%llu sdk_full_waits=%llu sdk_full_wait_ms=%.1f\n",
+               (unsigned long long)frame_current_, int(rcomp_mx_mode_), (unsigned long long)s.draws,
+               (unsigned long long)s.bytes, (unsigned long long)s.retired_polled, (unsigned long long)s.retired_flushed,
+               retired ? double(s.lag_frames) / double(retired) : 0.0, rcomp_mx_pending_.size(),
+               (unsigned long long)s.max_pending, (unsigned long long)s.chunks, (unsigned long long)s.sdk_fallbacks,
+               (unsigned long long)s.sdk_fast_hits, (unsigned long long)s.sdk_fast_to_full,
+               (unsigned long long)s.sdk_full_waits, double(s.sdk_full_wait_us) * 1e-3);
+  if (rcomp_mx_mode_) {
+    static const char* const kNames[kRcompMxTriggerCount] = {"inval", "irq",     "shd",      "ext",       "zpd",
+                                                              "memw",  "r2m",     "condw",    "scratch",   "waitreg",
+                                                              "capacity", "sdk", "shutdown"};
+    char line[1024];
+    int n = std::snprintf(line, sizeof(line), "RCOMP-MEMEXPORT-RB-FLUSH frame=%llu (flushes/blocking/ms)",
+                          (unsigned long long)frame_current_);
+    for (uint32_t i = 0; i < kRcompMxTriggerCount && n > 0 && n < int(sizeof(line)); ++i) {
+      n += std::snprintf(line + n, sizeof(line) - n, " %s=%llu/%llu/%.1f", kNames[i], (unsigned long long)s.flushes[i],
+                         (unsigned long long)s.blocking[i], double(s.blocking_us[i]) * 1e-3);
+    }
+    std::fprintf(stderr, "%s\n", line);
+  }
+}
+
+void VulkanCommandProcessor::RcompMxShutdown() {
+  RcompMxRetireCompleted();
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (RcompMxChunk& chunk : rcomp_mx_chunks_) {
+    if (chunk.mapping) {
+      dfn.vkUnmapMemory(device, chunk.memory);
+    }
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkDestroyBuffer, device, chunk.buffer);
+    ui::vulkan::util::DestroyAndNullHandle(dfn.vkFreeMemory, device, chunk.memory);
+  }
+  rcomp_mx_chunks_.clear();
+  rcomp_mx_pending_.clear();
+  rcomp_mx_ranges_.clear();
+  rcomp_mx_cpu_overlap_ = false;
+  RcompMxUpdateArm();
+}
