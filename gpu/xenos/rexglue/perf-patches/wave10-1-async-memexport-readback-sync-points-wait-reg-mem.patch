+
+void VulkanCommandProcessor::RcompSyncPoint(uint32_t kind) {
+  if (kind == kRcompSyncPointInvalidation) {
+    if (rcomp_mx_cpu_overlap_) {
+      rcomp_mx_cpu_overlap_ = false;
+      RcompMxFlush(kRcompMxTriggerInvalidation);
+    }
+  } else if (rcomp_mx_mode_ == 1 && !rcomp_mx_pending_.empty()) {
+    RcompMxTrigger trigger;
+    switch (kind) {
+      case xenos::PM4_INTERRUPT:
+        trigger = kRcompMxTriggerInterrupt;
+        break;
+      case xenos::PM4_EVENT_WRITE_SHD:
+        trigger = kRcompMxTriggerEventShd;
+        break;
+      case xenos::PM4_EVENT_WRITE_EXT:
+        trigger = kRcompMxTriggerEventExt;
+        break;
+      case xenos::PM4_EVENT_WRITE_ZPD:
+        trigger = kRcompMxTriggerEventZpd;
+        break;
+      case xenos::PM4_MEM_WRITE:
+        trigger = kRcompMxTriggerMemWrite;
+        break;
+      case xenos::PM4_REG_TO_MEM:
+        trigger = kRcompMxTriggerRegToMem;
+        break;
+      case xenos::PM4_COND_WRITE:
+        trigger = kRcompMxTriggerCondWrite;
+        break;
+      case xenos::PM4_WAIT_REG_MEM:
+        trigger = kRcompMxTriggerWaitRegMem;
+        break;
+      default:
+        trigger = kRcompMxTriggerScratch;
+        break;
+    }
+    RcompMxFlush(trigger);
+  }
+  RcompMxUpdateArm();
+}
+
+void VulkanCommandProcessor::RcompMxUpdateArm() {
+  rcomp_sync_points_armed_ = rcomp_mx_cpu_overlap_ || (rcomp_mx_mode_ == 1 && !rcomp_mx_pending_.empty());
+}
+
+void VulkanCommandProcessor::RcompMxNoteCpuInvalidation(uint32_t address_first, uint32_t address_last) {
+  if (rcomp_mx_pending_.empty() || rcomp_mx_cpu_overlap_ || address_last < rcomp_mx_extent_first_ ||
+      address_first > rcomp_mx_extent_last_) {
+    return;
+  }
+  for (const draw_util::MemExportRange& range : rcomp_mx_ranges_) {
+    const uint64_t first = uint64_t(range.base_address_dwords) << 2;
+    const uint64_t end = first + range.size_bytes;  // exclusive
+    if (range.size_bytes && first <= address_last && end > address_first) {
+      // Pages holding data a pending copy has not brought to the guest memory yet will be uploaded from the guest memory:
+      // the copies must land first (RcompSyncPoint(kRcompSyncPointInvalidation), right after the invalidation).
+      rcomp_mx_cpu_overlap_ = true;
+      rcomp_sync_points_armed_ = true;
+      return;
+    }
+  }
+}
