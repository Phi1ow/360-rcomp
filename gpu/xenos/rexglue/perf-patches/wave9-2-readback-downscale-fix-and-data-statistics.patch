+namespace {
+// Set when the R-comp downscale pipeline replaced the SDK's (one command processor per title).
+bool rcomp_readback_downscale_fixed = false;
+// Push constants: the SDK's ResolveDownscaleConstants, tile_count carrying the number of 32-bit words to write.
+const char kRcompReadbackDownscaleGlsl[] = R"GLSL(#version 450
+layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
+layout(push_constant) uniform Constants {
+  uint scale_x;
+  uint scale_y;
+  uint pixel_size_log2;
+  uint word_count;
+  uint source_offset_bytes;
+  uint half_pixel_offset;
+} pc;
+layout(std430, set = 0, binding = 0) readonly buffer SourceBuffer { uint data[]; } source_buffer;
+layout(std430, set = 0, binding = 1) writeonly buffer DestBuffer { uint data[]; } dest_buffer;
+
+// Byte of the bound scaled range holding the chosen host pixel of guest pixel k of the 16-byte group at unscaled offset group_byte (n guest pixels per group).
+uint SourceByte(uint group_byte, uint k, uint n, uint offset_x, uint offset_y) {
+  uint x = k * pc.scale_x + offset_x;
+  uint rx = x / n;
+  uint j = x - rx * n;
+  return pc.source_offset_bytes + group_byte * (pc.scale_x * pc.scale_y) +
+         (((rx * pc.scale_y + offset_y) * n + j) << pc.pixel_size_log2);
+}
+
+void main() {
+  uint d = gl_GlobalInvocationID.x;
+  if (d >= pc.word_count) {
+    return;
+  }
+  uint o = d << 2u;
+  uint group_byte = o & ~15u;
+  uint n = 16u >> pc.pixel_size_log2;
+  uint offset_x = 0u;
+  uint offset_y = 0u;
+  if (pc.half_pixel_offset != 0u) {
+    offset_x = pc.scale_x >> 1u;
+    offset_y = pc.scale_y >> 1u;
+  }
+  uint word = 0u;
+  if (pc.pixel_size_log2 >= 3u) {
+    // 64 bits: this word is one half of guest pixel k.
+    uint b = SourceByte(group_byte, (o & 15u) >> 3u, n, offset_x, offset_y) + (o & 4u);
+    word = source_buffer.data[b >> 2u];
+  } else if (pc.pixel_size_log2 == 2u) {
+    uint b = SourceByte(group_byte, (o & 15u) >> 2u, n, offset_x, offset_y);
+    word = source_buffer.data[b >> 2u];
+  } else {
+    // 8 or 16 bits: the word holds 4 or 2 guest pixels, each taken from its own host pixel.
+    uint bits = 8u << pc.pixel_size_log2;
+    uint pixels = 4u >> pc.pixel_size_log2;
+    uint first = (o & 15u) >> pc.pixel_size_log2;
+    uint mask = (1u << bits) - 1u;
+    for (uint i = 0u; i < pixels; ++i) {
+      uint b = SourceByte(group_byte, first + i, n, offset_x, offset_y);
+      word |= ((source_buffer.data[b >> 2u] >> ((b & 3u) * 8u)) & mask) << (i * bits);
+    }
+  }
+  dest_buffer.data[d] = word;
+}
+)GLSL";
+}  // namespace
 
