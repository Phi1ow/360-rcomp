+
+// The color render targets (bit 1 + i for target i) that a rectangle list with a pixel shader replaces
+// entirely wherever it is rasterized: the shader cannot discard, the alpha, depth and stencil tests cannot
+// fail, nothing is culled or clipped, the write mask is full and the blending does not read the
+// destination. See RenderTargetCache::Update.
+uint32_t OverwrittenColorRenderTargets(const RegisterFile& regs, xenos::PrimitiveType prim_type,
+                                       uint32_t index_count, const Shader& pixel_shader,
+                                       const reg::RB_DEPTHCONTROL& depth_control,
+                                       uint32_t normalized_color_mask,
+                                       bool depth_clamp_available) {
+  if (prim_type != xenos::PrimitiveType::kRectangleList || index_count != 3 ||
+      !depth_clamp_available || pixel_shader.kills_pixels()) {
+    return 0;
+  }
+  const auto color_control = regs.Get<reg::RB_COLORCONTROL>();
+  if ((color_control.alpha_test_enable && color_control.alpha_func != xenos::CompareFunction::kAlways) ||
+      color_control.alpha_to_mask_enable) {
+    return 0;
+  }
+  if (depth_control.z_enable && depth_control.zfunc != xenos::CompareFunction::kAlways) {
+    return 0;
+  }
+  if (depth_control.stencil_enable &&
+      (depth_control.stencilfunc != xenos::CompareFunction::kAlways ||
+       (depth_control.backface_enable &&
+        depth_control.stencilfunc_bf != xenos::CompareFunction::kAlways))) {
+    return 0;
+  }
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (pa_su_sc_mode_cntl.cull_front || pa_su_sc_mode_cntl.cull_back ||
+      pa_su_sc_mode_cntl.poly_mode == xenos::PolygonModeEnable::kDualMode ||
+      !regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable) {
+    return 0;
+  }
+  const auto reads_destination = [](xenos::BlendFactor source, xenos::BlendFactor destination,
+                                    xenos::BlendOp op) {
+    return op == xenos::BlendOp::kMin || op == xenos::BlendOp::kMax ||
+           destination != xenos::BlendFactor::kZero || source == xenos::BlendFactor::kDstColor ||
+           source == xenos::BlendFactor::kOneMinusDstColor || source == xenos::BlendFactor::kDstAlpha ||
+           source == xenos::BlendFactor::kOneMinusDstAlpha;
+  };
+  uint32_t overwritten = 0;
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (((normalized_color_mask >> (4 * i)) & 0xF) != 0xF) {
+      continue;
+    }
+    const auto blend = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]);
+    if (reads_destination(blend.color_srcblend, blend.color_destblend, blend.color_comb_fcn) ||
+        reads_destination(blend.alpha_srcblend, blend.alpha_destblend, blend.alpha_comb_fcn)) {
+      continue;
+    }
+    overwritten |= uint32_t(1) << (1 + i);
+  }
+  return overwritten;
+}
