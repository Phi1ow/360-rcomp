+namespace {
+// Whether the state of a draw makes it overwrite every bit of depth and stencil wherever it is
+// rasterized (see RenderTargetCache::Update): one rectangle of three guest vertices, drawn without a
+// pixel shader, with the depth test always passing and depth written, the stencil always replaced in
+// all bits, and nothing culled or clipped (the host would otherwise not draw all of it).
+bool IsDepthStencilOverwritingRectangle(const RegisterFile& regs, xenos::PrimitiveType prim_type,
+                                        uint32_t index_count, bool has_pixel_shader,
+                                        const reg::RB_DEPTHCONTROL& depth_control,
+                                        bool depth_clamp_available) {
+  if (prim_type != xenos::PrimitiveType::kRectangleList || index_count != 3 || has_pixel_shader ||
+      !depth_clamp_available) {
+    return false;
+  }
+  if (!depth_control.z_enable || !depth_control.z_write_enable ||
+      depth_control.zfunc != xenos::CompareFunction::kAlways || !depth_control.stencil_enable) {
+    return false;
+  }
+  // Both the stencil and the depth test always pass, so only the pass operation is applied.
+  const auto stencil_replaced = [](xenos::CompareFunction function, xenos::StencilOp pass,
+                                   uint32_t write_mask) {
+    return function == xenos::CompareFunction::kAlways &&
+           (pass == xenos::StencilOp::kReplace || pass == xenos::StencilOp::kZero) &&
+           write_mask == 0xFF;
+  };
+  if (!stencil_replaced(depth_control.stencilfunc, depth_control.stencilzpass,
+                        regs.Get<reg::RB_STENCILREFMASK>().stencilwritemask)) {
+    return false;
+  }
+  if (depth_control.backface_enable &&
+      !stencil_replaced(depth_control.stencilfunc_bf, depth_control.stencilzpass_bf,
+                        regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF)
+                            .stencilwritemask)) {
+    return false;
+  }
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (pa_su_sc_mode_cntl.cull_front || pa_su_sc_mode_cntl.cull_back ||
+      pa_su_sc_mode_cntl.poly_mode == xenos::PolygonModeEnable::kDualMode) {
+    return false;
+  }
+  // With clipping disabled the user clip planes are not applied either (see the system constants).
+  return regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable != 0;
+}
