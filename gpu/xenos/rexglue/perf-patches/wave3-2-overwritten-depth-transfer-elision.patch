+  float half_pixel = regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero ? 0.5f : 0.0f;
+  float window_x = 0.0f, window_y = 0.0f;
+  if (pa_su_sc_mode_cntl.vtx_window_offset_enable) {
+    auto pa_sc_window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    window_x = float(int32_t(pa_sc_window_offset.window_x_offset));
+    window_y = float(int32_t(pa_sc_window_offset.window_y_offset));
+  }
+  float xs[4], ys[4];
+  for (uint32_t i = 0; i < 4; ++i) {
+    float x = position[i][0];
+    float y = position[i][1];
+    if (!pa_cl_vte_cntl.vtx_xy_fmt) {
+      float w = position[i][2];
+      if (!(w != 0.0f)) {
+        last_rectangle_refusal_ = 9;
+        return false;
+      }
+      x /= w;
+      y /= w;
+    }
+    x = x * scale_x + offset_x + half_pixel + window_x;
+    y = y * scale_y + offset_y + half_pixel + window_y;
+    if (!std::isfinite(x) || !std::isfinite(y)) {
+      last_rectangle_refusal_ = 10;
+      return false;
+    }
+    xs[i] = x;
+    ys[i] = y;
+  }
+  float min_x = std::min(std::min(xs[0], xs[1]), std::min(xs[2], xs[3]));
+  float max_x = std::max(std::max(xs[0], xs[1]), std::max(xs[2], xs[3]));
+  float min_y = std::min(std::min(ys[0], ys[1]), std::min(ys[2], ys[3]));
+  float max_y = std::max(std::max(ys[0], ys[1]), std::max(ys[2], ys[3]));
+  if (!(max_x - min_x >= 1.0f) || !(max_y - min_y >= 1.0f)) {
+    last_rectangle_refusal_ = 11;
+    return false;
+  }
+  // The four vertices must be the four distinct corners of that rectangle (positions are exact for
+  // the screen-space rectangles Direct3D 9 draws; the tolerance covers float rounding of the
+  // viewport transformation only).
+  constexpr float kTolerance = 1.0f / 256.0f;
+  bool corner_seen[2][2] = {};
+  for (uint32_t i = 0; i < 4; ++i) {
+    int cx, cy;
+    if (std::abs(xs[i] - min_x) <= kTolerance) {
+      cx = 0;
+    } else if (std::abs(xs[i] - max_x) <= kTolerance) {
+      cx = 1;
+    } else {
+      last_rectangle_refusal_ = 12;
+      return false;
+    }
+    if (std::abs(ys[i] - min_y) <= kTolerance) {
+      cy = 0;
+    } else if (std::abs(ys[i] - max_y) <= kTolerance) {
+      cy = 1;
+    } else {
+      last_rectangle_refusal_ = 12;
+      return false;
+    }
+    if (corner_seen[cy][cx]) {
+      last_rectangle_refusal_ = 12;
+      return false;
+    }
+    corner_seen[cy][cx] = true;
+  }
+  bounds_out[0] = min_x;
+  bounds_out[1] = min_y;
+  bounds_out[2] = max_x;
+  bounds_out[3] = max_y;
+  return true;
 }
 
