+}
+
+void VulkanCommandProcessor::RcompPassBegin(uint64_t class_key, uint64_t pixels, uint32_t tiles,
+                                            uint32_t category) {
+  auto& g = rcomp_gpu_profile;
+  if (!submission_open_ || g.pool == VK_NULL_HANDLE || g.open_submission != GetCurrentSubmission() ||
+      g.used >= RcompGpuProfile::kSlice || g.passes.size() >= 0xFFFFu - kRcompFirstPassLabel)
+    return;
+  RcompGpuMark(kRcompFirstPassLabel + uint32_t(g.passes.size()));
+  g.passes.push_back({class_key, pixels, tiles, category});
+}
+
+void VulkanCommandProcessor::RcompPassEnd(uint32_t category) {
+  RcompGpuMark(category);
+}
