+namespace {
+// Bounded event timeline (RCOMP-EV lines): the draw runs, render target transfers and resolves of a
+// few consecutive guest frames at several points of the run, in command order, for offline analysis
+// (tools/xenos_pass_analysis.py). A draw run is a stretch of draws with the same render targets and
+// the same state classes (rcomp_draw_flags); the lines are
+//   D+ n= f= rts=<depth>,<c0>..<c3> prim= flags= sc=<l,t,r,b> vp=<x,y,w,h>   first draw of a run
+//   D- n= draws= verts= zr= zw= st= bl= pm= nops= kill= clip= zalways= rect= wd= claim=<base+len>,...
+//   T  n= f= dest= src= hd= t=<a>..<b> r=<x,y+wxh>... cl=       one transfer (see render_target_cache.cpp)
+//   R  n= f= ...                                                one resolve
+constexpr uint64_t kRcompEventStarts[] = {1500, 3500, 5500, 7500, 9500, 11500};
+constexpr uint64_t kRcompEventFrames = 2;
+struct RcompDrawRun {
+  bool open = false;
+  uint64_t frame = 0, seq = 0;
+  uint32_t rt[5] = {};
+  uint32_t flags = 0;
+  uint32_t draws = 0, vertices = 0, z_read = 0, z_write = 0, stencil = 0, blend = 0, partial_mask = 0, no_ps = 0,
+           kills = 0, clip_off = 0, z_always = 0, rect = 0, writes_depth = 0;
+  uint32_t claim_base[5] = {}, claim_length[5] = {};
+} rcomp_run;
+uint64_t rcomp_event_seq = 0;
+}  // namespace
+
+uint64_t VulkanCommandProcessor::RcompNextEventSeq() { return ++rcomp_event_seq; }
+
+bool VulkanCommandProcessor::RcompEventsOpen() {
+  bool open = false;
+  for (const uint64_t start : kRcompEventStarts)
+    if (frame_current_ >= start && frame_current_ < start + kRcompEventFrames) {
+      open = true;
+      break;
+    }
+  if (!open && rcomp_run.open) RcompFlushDrawRun();
+  return open;
+}
+
+void VulkanCommandProcessor::RcompFlushDrawRun() {
+  RcompDrawRun& r = rcomp_run;
+  if (!r.open) return;
+  r.open = false;
+  std::fprintf(stderr,
+               "RCOMP-EV D- n=%llu draws=%u verts=%u zr=%u zw=%u st=%u bl=%u pm=%u nops=%u kill=%u clip=%u zalways=%u rect=%u wd=%u "
+               "claim=%u+%u,%u+%u,%u+%u,%u+%u,%u+%u\n",
+               (unsigned long long)r.seq, r.draws, r.vertices, r.z_read, r.z_write, r.stencil, r.blend, r.partial_mask,
+               r.no_ps, r.kills, r.clip_off, r.z_always, r.rect, r.writes_depth, r.claim_base[0], r.claim_length[0],
+               r.claim_base[1], r.claim_length[1], r.claim_base[2], r.claim_length[2], r.claim_base[3],
+               r.claim_length[3], r.claim_base[4], r.claim_length[4]);
+}
+
+void VulkanCommandProcessor::RcompDrawEvent(const RcompDrawEventInfo& d) {
+  if (!RcompEventsOpen()) return;
+  RcompDrawRun& r = rcomp_run;
+  const bool same = r.open && r.frame == frame_current_ && !std::memcmp(r.rt, d.rt_key, sizeof(r.rt)) &&
+                    r.flags == d.flags;
+  if (!same) {
+    RcompFlushDrawRun();
+    r = RcompDrawRun();
+    r.open = true;
+    r.frame = frame_current_;
+    r.seq = RcompNextEventSeq();
+    std::memcpy(r.rt, d.rt_key, sizeof(r.rt));
+    r.flags = d.flags;
+    char key[5][32];
+    for (int i = 0; i < 5; ++i) rcomp_pass::KeyText(d.rt_key[i], key[i]);
+    std::fprintf(stderr, "RCOMP-EV D+ n=%llu f=%llu rts=%s,%s,%s,%s,%s prim=%u flags=%x sc=%d,%d,%d,%d vp=%d,%d,%d,%d\n",
+                 (unsigned long long)r.seq, (unsigned long long)frame_current_, key[0], key[1], key[2], key[3], key[4],
+                 d.prim_type, d.flags, d.scissor[0], d.scissor[1], d.scissor[2], d.scissor[3], d.viewport[0],
+                 d.viewport[1], d.viewport[2], d.viewport[3]);
+  }
+  using namespace rcomp_draw_flags;
+  ++r.draws;
+  r.vertices += d.vertices;
+  r.z_read += (d.flags & kZRead) != 0;
+  r.z_write += (d.flags & kZWrite) != 0;
+  r.stencil += (d.flags & kStencil) != 0;
+  r.blend += (d.flags & kBlend) != 0;
+  r.partial_mask += (d.flags & kPartialColorMask) != 0;
+  r.no_ps += (d.flags & kNoPixelShader) != 0;
+  r.kills += (d.flags & kKills) != 0;
+  r.clip_off += (d.flags & kClipDisabled) != 0;
+  r.z_always += (d.flags & kZAlways) != 0;
+  r.rect += (d.flags & kRectList) != 0;
+  r.writes_depth += (d.flags & kWritesDepth) != 0;
+  for (int i = 0; i < 5; ++i) {
+    r.claim_base[i] = d.claim_base[i];
+    r.claim_length[i] = std::max(r.claim_length[i], d.claim_length[i]);
+  }
 }
 
