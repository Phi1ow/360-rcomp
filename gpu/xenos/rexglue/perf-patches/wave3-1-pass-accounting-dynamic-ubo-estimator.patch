+uint8_t* VulkanCommandProcessor::RequestConstants(size_t size, size_t alignment, VkBuffer& buffer_out,
+                                                 VkDeviceSize& offset_out) {
+  // The pages are ui::GraphicsUploadBufferPool::kDefaultPageSize (2 MiB) or larger; this only
+  // assumes the smaller size.
+  constexpr size_t kPageBytes = ui::GraphicsUploadBufferPool::kDefaultPageSize;
+  constexpr size_t kLargestRange = sizeof(float) * 4 * 256;
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    uint8_t* mapping =
+        uniform_buffer_pool_->Request(frame_current_, size, alignment, buffer_out, offset_out);
+    if (!mapping) {
+      return nullptr;
+    }
+    if (size_t(offset_out) + kLargestRange <= kPageBytes) {
+      return mapping;
+    }
+    // Skip what is left of the page so that the next request starts a new one.
+    const size_t aligned_end = (size_t(offset_out) + size + alignment - 1) & ~(alignment - 1);
+    const size_t rest = (kPageBytes > aligned_end ? kPageBytes - aligned_end : 0) & ~(alignment - 1);
+    if (rest) {
+      VkBuffer skipped_buffer;
+      VkDeviceSize skipped_offset;
+      uniform_buffer_pool_->Request(frame_current_, rest, alignment, skipped_buffer, skipped_offset);
+    }
+  }
+  return nullptr;
+}
+
+VkDescriptorSet VulkanCommandProcessor::GetConstantsDescriptorSet(VkBuffer page_buffer) {
+  auto found = constants_page_descriptor_sets_.find(page_buffer);
+  if (found != constants_page_descriptor_sets_.end()) {
+    return found->second;
+  }
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  VkDescriptorSetAllocateInfo allocate_info;
+  allocate_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+  allocate_info.pNext = nullptr;
+  allocate_info.descriptorSetCount = 1;
+  allocate_info.pSetLayouts = &descriptor_set_layout_constants_;
+  VkDescriptorSet set = VK_NULL_HANDLE;
+  for (int attempt = 0; attempt < 2 && set == VK_NULL_HANDLE; ++attempt) {
+    if (constants_page_descriptor_pools_.empty() || attempt) {
+      constexpr uint32_t kSetsPerPool = 256;
+      VkDescriptorPoolSize pool_size;
+      pool_size.type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC;
+      pool_size.descriptorCount = SpirvShaderTranslator::kConstantBufferCount * kSetsPerPool;
+      VkDescriptorPoolCreateInfo pool_create_info;
+      pool_create_info.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO;
+      pool_create_info.pNext = nullptr;
+      pool_create_info.flags = 0;
+      pool_create_info.maxSets = kSetsPerPool;
+      pool_create_info.poolSizeCount = 1;
+      pool_create_info.pPoolSizes = &pool_size;
+      VkDescriptorPool pool;
+      if (dfn.vkCreateDescriptorPool(device, &pool_create_info, nullptr, &pool) != VK_SUCCESS) {
+        REXGPU_ERROR("Failed to create a Vulkan descriptor pool for the guest constants");
+        return VK_NULL_HANDLE;
+      }
+      constants_page_descriptor_pools_.push_back(pool);
+    }
+    allocate_info.descriptorPool = constants_page_descriptor_pools_.back();
+    if (dfn.vkAllocateDescriptorSets(device, &allocate_info, &set) != VK_SUCCESS) {
+      set = VK_NULL_HANDLE;
+    }
+  }
+  if (set == VK_NULL_HANDLE) {
+    REXGPU_ERROR("Failed to allocate a Vulkan descriptor set for the guest constants");
+    return VK_NULL_HANDLE;
+  }
+  // The largest range of each constant buffer: the shader only reads what the draw uploaded.
+  const VkDeviceSize ranges[SpirvShaderTranslator::kConstantBufferCount] = {
+      /* system */ sizeof(SpirvShaderTranslator::SystemConstants),
+      /* float vertex */ sizeof(float) * 4 * 256,
+      /* float pixel */ sizeof(float) * 4 * 256,
+      /* bool and loop */ sizeof(uint32_t) * (8 + 32),
+      /* fetch */ sizeof(uint32_t) * 6 * 32,
+  };
+  static_assert(SpirvShaderTranslator::kConstantBufferSystem == 0 &&
+                    SpirvShaderTranslator::kConstantBufferFloatVertex == 1 &&
+                    SpirvShaderTranslator::kConstantBufferFloatPixel == 2 &&
+                    SpirvShaderTranslator::kConstantBufferBoolLoop == 3 &&
+                    SpirvShaderTranslator::kConstantBufferFetch == 4,
+                "The ranges above are listed in the order of the constant buffer indices");
+  VkDescriptorBufferInfo buffer_infos[SpirvShaderTranslator::kConstantBufferCount];
+  VkWriteDescriptorSet writes[SpirvShaderTranslator::kConstantBufferCount];
+  for (uint32_t i = 0; i < SpirvShaderTranslator::kConstantBufferCount; ++i) {
+    buffer_infos[i].buffer = page_buffer;
+    buffer_infos[i].offset = 0;
+    buffer_infos[i].range = ranges[i];
+    VkWriteDescriptorSet& write = writes[i];
+    write.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+    write.pNext = nullptr;
+    write.dstSet = set;
+    write.dstBinding = i;
+    write.dstArrayElement = 0;
+    write.descriptorCount = 1;
+    write.descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC;
+    write.pImageInfo = nullptr;
+    write.pBufferInfo = &buffer_infos[i];
+    write.pTexelBufferView = nullptr;
+  }
+  dfn.vkUpdateDescriptorSets(device, SpirvShaderTranslator::kConstantBufferCount, writes, 0, nullptr);
+  constants_page_descriptor_sets_.emplace(page_buffer, set);
+  return set;
 }
 
