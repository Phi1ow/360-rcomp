+// GPU time and work per pass class (rcomp_pass:: keys), summed over the run on the CP thread.
+struct RcompClassStat {
+  uint64_t count = 0, ticks = 0, pixels = 0, tiles = 0;
+};
+std::unordered_map<uint64_t, RcompClassStat> rcomp_pass_classes;
+
+std::string RcompDescribeRt(uint32_t type) {
+  const uint32_t msaa = type & 3, is_depth = (type >> 2) & 1, format = type >> 3;
+  char text[64];
+  std::snprintf(text, sizeof text, "%s:%s/%ux", is_depth ? "D" : "C",
+                is_depth ? xenos::GetDepthRenderTargetFormatName(xenos::DepthRenderTargetFormat(format))
+                         : xenos::GetColorRenderTargetFormatName(xenos::ColorRenderTargetFormat(format)),
+                1u << msaa);
+  return text;
+}
+
+std::string RcompDescribeClass(uint64_t key) {
+  char text[160];
+  switch (key & 0xF) {
+    case rcomp_pass::kTransfer:
+      std::snprintf(text, sizeof text, "transfer dest=%s src=%s mode=%u hostdepth=%u",
+                    RcompDescribeRt(uint32_t(key >> 4) & 0x7F).c_str(),
+                    RcompDescribeRt(uint32_t(key >> 11) & 0x7F).c_str(), uint32_t(key >> 18) & 0x1F,
+                    uint32_t(key >> 23) & 1);
+      break;
+    case rcomp_pass::kHostDepthStore:
+      std::snprintf(text, sizeof text, "host-depth-store dest=%s", RcompDescribeRt(uint32_t(key >> 4) & 0x7F).c_str());
+      break;
+    case rcomp_pass::kResolveDump:
+      std::snprintf(text, sizeof text, "resolve-dump rt=%s", RcompDescribeRt(uint32_t(key >> 4) & 0x7F).c_str());
+      break;
+    case rcomp_pass::kResolveCopy:
+      std::snprintf(text, sizeof text, "resolve-copy shader=%u scaled=%u", uint32_t(key >> 4) & 0xFF,
+                    uint32_t(key >> 12) & 1);
+      break;
+    case rcomp_pass::kResolveClear:
+      std::snprintf(text, sizeof text, "resolve-clear rt=%s", RcompDescribeRt(uint32_t(key >> 4) & 0x7F).c_str());
+      break;
+    default:
+      std::snprintf(text, sizeof text, "kind=%u", uint32_t(key & 0xF));
+  }
+  return text;
+}
+
+// Cumulative class table every 20 s of wall time (differences of two tables give the rate between them).
+void RcompPassDump() {
+  static const auto start = std::chrono::steady_clock::now();
+  static auto next = start + std::chrono::seconds(20);
+  const auto now = std::chrono::steady_clock::now();
+  if (now < next || rcomp_pass_classes.empty()) return;
+  next = now + std::chrono::seconds(20);
+  std::vector<std::pair<uint64_t, RcompClassStat>> rows(rcomp_pass_classes.begin(), rcomp_pass_classes.end());
+  std::sort(rows.begin(), rows.end(), [](const auto& a, const auto& b) { return a.second.ticks > b.second.ticks; });
+  std::fprintf(stderr, "RCOMP-PASS-TABLE wall_ms=%llu swaps=%llu classes=%zu\n",
+               (unsigned long long)std::chrono::duration_cast<std::chrono::milliseconds>(now - start).count(),
+               (unsigned long long)rcomp_prof[22].load(std::memory_order_relaxed), rows.size());
+  for (size_t i = 0; i < rows.size() && i < 64; ++i) {
+    const auto& s = rows[i].second;
+    std::fprintf(stderr, "RCOMP-PASS key=%llx n=%llu ticks=%llu px=%llu tiles=%llu %s\n",
+                 (unsigned long long)rows[i].first, (unsigned long long)s.count, (unsigned long long)s.ticks,
+                 (unsigned long long)s.pixels, (unsigned long long)s.tiles, RcompDescribeClass(rows[i].first).c_str());
+  }
+}
