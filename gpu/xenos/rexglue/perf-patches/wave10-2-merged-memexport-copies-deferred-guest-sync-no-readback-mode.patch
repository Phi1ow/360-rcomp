+uint64_t VulkanCommandProcessor::RcompMxRequiredSubmission() const {
+  uint64_t required = 0;
+  if (!rcomp_mx_unflushed_.empty()) {
+    // Copied at the end of the open submission.
+    required = GetCurrentSubmission();
+  } else if (!rcomp_mx_pending_.empty()) {
+    required = rcomp_mx_pending_.back().submission;
+  }
+  if (!rcomp_mx_visible_.empty()) {
+    required = std::max(required, rcomp_mx_visible_.back().required);
+  }
+  return required;
+}
+
+bool VulkanCommandProcessor::RcompDeferGuestWrite(uint32_t address, uint32_t stored_word) {
+  if (rcomp_mx_mode_ != 1 || !RcompMxAnythingPending()) {
+    return false;
+  }
+  RcompMxVisible entry;
+  entry.required = RcompMxRequiredSubmission();
+  entry.queued_ns = uint64_t(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+  entry.is_interrupt = 0;
+  entry.address = address;
+  entry.word = stored_word;
+  rcomp_mx_visible_.push_back(entry);
+  ++rcomp_mx_stats_.deferred_writes;
+  rcomp_mx_stats_.max_visible = std::max(rcomp_mx_stats_.max_visible, uint64_t(rcomp_mx_visible_.size()));
+  RcompMxUpdateArm();
+  return true;
+}
+
+bool VulkanCommandProcessor::RcompDeferInterrupt(uint32_t cpu_mask) {
+  if (rcomp_mx_mode_ != 1 || !RcompMxAnythingPending()) {
+    return false;
+  }
+  RcompMxVisible entry;
+  entry.required = RcompMxRequiredSubmission();
+  entry.queued_ns = uint64_t(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+  entry.is_interrupt = 1;
+  entry.address = cpu_mask;
+  entry.word = 0;
+  rcomp_mx_visible_.push_back(entry);
+  ++rcomp_mx_stats_.deferred_irqs;
+  rcomp_mx_stats_.max_visible = std::max(rcomp_mx_stats_.max_visible, uint64_t(rcomp_mx_visible_.size()));
+  RcompMxUpdateArm();
+  return true;
 }
 
