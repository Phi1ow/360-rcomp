+void VulkanCommandProcessor::VertexBufferWatchThunk(const std::unique_lock<std::recursive_mutex>& /*global_lock*/, void* context,
+                                                    uint32_t address_first, uint32_t address_last, bool invalidated_by_gpu) {
+  if (!invalidated_by_gpu) {
+    static_cast<VulkanCommandProcessor*>(context)->InvalidateVertexBufferStatesInRange(address_first, address_last);
+  }
+}
+
+void VulkanCommandProcessor::InvalidateVertexBufferStatesInRange(uint32_t address_first, uint32_t address_last) {
+  for (uint32_t i = 0; i < vertex_buffer_states_.size(); ++i) {
+    VertexBufferState& state = vertex_buffer_states_[i];
+    if (state.address == UINT32_MAX) {
+      continue;
+    }
+    const uint64_t start = uint64_t(state.address) << 2;
+    const uint64_t end = start + (uint64_t(state.size) << 2);  // exclusive
+    if (start <= address_last && end > address_first) {
+      state.address = UINT32_MAX;
+      state.size = UINT32_MAX;
+      vertex_buffers_in_sync_[i >> 6] &= ~(uint64_t(1) << (i & 63));
+    }
+  }
+}
