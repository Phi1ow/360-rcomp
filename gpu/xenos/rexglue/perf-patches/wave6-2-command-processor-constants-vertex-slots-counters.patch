+namespace {
+// True if the `count` registers hold exactly the big-endian words the guest wrote (what copy_and_swap would store).
+bool RcompRegistersEqualGuestWords(const uint32_t* registers, const uint32_t* guest_words, uint32_t count) {
+  uint32_t i = 0;
+  const __m128i swap_mask = _mm_set_epi8(12, 13, 14, 15, 8, 9, 10, 11, 4, 5, 6, 7, 0, 1, 2, 3);
+  for (; i + 4 <= count; i += 4) {
+    const __m128i have = _mm_loadu_si128(reinterpret_cast<const __m128i*>(registers + i));
+    const __m128i written = _mm_shuffle_epi8(_mm_loadu_si128(reinterpret_cast<const __m128i*>(guest_words + i)), swap_mask);
+    if (_mm_movemask_epi8(_mm_cmpeq_epi8(have, written)) != 0xFFFF) {
+      return false;
+    }
+  }
+  for (; i < count; ++i) {
+    if (registers[i] != __builtin_bswap32(guest_words[i])) {
+      return false;
+    }
+  }
+  return true;
+}
