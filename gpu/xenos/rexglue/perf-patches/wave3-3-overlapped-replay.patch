+void VulkanCommandProcessor::AsyncSubmitRun() {
+  const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  const VkDevice device = vulkan_device->device();
+  for (;;) {
+    AsyncChunk chunk;
+    {
+      std::unique_lock<std::mutex> lock(async_mutex_);
+      async_wake_.wait(lock, [this] { return !async_queue_.empty() || async_stop_; });
+      if (async_queue_.empty()) {
+        return;
+      }
+      chunk = std::move(async_queue_.front());
+      async_queue_.pop_front();
+    }
+    const VkCommandBuffer command_buffer = chunk.command_buffer.buffer;
+    if (chunk.first) {
+      if (dfn.vkResetCommandPool(device, chunk.command_buffer.pool, 0) != VK_SUCCESS) {
+        rcomp_fatal(RCOMP_FATAL_PLATFORM, "xenos: failed to reset a Vulkan command pool");
+      }
+      VkCommandBufferBeginInfo begin_info;
+      begin_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+      begin_info.pNext = nullptr;
+      begin_info.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      begin_info.pInheritanceInfo = nullptr;
+      if (dfn.vkBeginCommandBuffer(command_buffer, &begin_info) != VK_SUCCESS) {
+        rcomp_fatal(RCOMP_FATAL_PLATFORM, "xenos: failed to begin a Vulkan command buffer");
+      }
+    }
+    {
+      RcompProfScope rcomp_prof_execute(60);
+      chunk.commands->Execute(command_buffer);
+    }
+    chunk.commands->Reset();
+    {
+      std::lock_guard<std::mutex> lock(async_mutex_);
+      async_spare_.push_back(std::move(chunk.commands));
+    }
+    if (chunk.last) {
+      RcompProfScope rcomp_prof_submit(62);
+      if (dfn.vkEndCommandBuffer(command_buffer) != VK_SUCCESS) {
+        rcomp_fatal(RCOMP_FATAL_PLATFORM, "xenos: failed to end a Vulkan command buffer");
+      }
+      VkSubmitInfo submit_info;
+      submit_info.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+      submit_info.pNext = nullptr;
+      submit_info.waitSemaphoreCount = uint32_t(chunk.wait_semaphores.size());
+      submit_info.pWaitSemaphores =
+          chunk.wait_semaphores.empty() ? nullptr : chunk.wait_semaphores.data();
+      submit_info.pWaitDstStageMask =
+          chunk.wait_stage_masks.empty() ? nullptr : chunk.wait_stage_masks.data();
+      submit_info.commandBufferCount = 1;
+      submit_info.pCommandBuffers = &command_buffer;
+      submit_info.signalSemaphoreCount = 0;
+      submit_info.pSignalSemaphores = nullptr;
+      VkResult submit_result;
+      {
+        ui::vulkan::VulkanDevice::Queue::Acquisition queue_acquisition =
+            vulkan_device->AcquireQueue(vulkan_device->queue_family_graphics_compute(), 0);
+        submit_result = dfn.vkQueueSubmit(queue_acquisition.queue(), 1, &submit_info, chunk.fence);
+      }
+      if (submit_result != VK_SUCCESS) {
+        rcomp_fatal(RCOMP_FATAL_PLATFORM, "xenos: failed to submit a Vulkan command buffer (VkResult %d)",
+                    int(submit_result));
+      }
+      {
+        std::lock_guard<std::mutex> lock(async_mutex_);
+        async_submitted_through_.store(chunk.submission, std::memory_order_release);
+      }
+      async_done_.notify_all();
+    }
+  }
+}
+
+void VulkanCommandProcessor::HandOffChunk(bool last, VkFence fence) {
+  if (!async_thread_.joinable()) {
+    async_thread_.Start([this] { AsyncSubmitRun(); });
+  }
+  std::unique_ptr<DeferredCommandBuffer> commands;
+  {
+    std::lock_guard<std::mutex> lock(async_mutex_);
+    if (!async_spare_.empty()) {
+      commands = std::move(async_spare_.back());
+      async_spare_.pop_back();
+    }
+  }
+  if (!commands) {
+    commands = std::make_unique<DeferredCommandBuffer>(*this);
+  }
+  deferred_command_buffer_.SwapStream(*commands);
+  AsyncChunk chunk;
+  chunk.commands = std::move(commands);
+  if (!async_in_submission_) {
+    // The callers made sure a writable command buffer exists (EnsureCommandBufferWritable).
+    assert_false(command_buffers_writable_.empty());
+    chunk.first = true;
+    async_command_buffer_ = command_buffers_writable_.back();
+    command_buffers_writable_.pop_back();
+    async_in_submission_ = true;
+  }
+  chunk.command_buffer = async_command_buffer_;
+  if (last) {
+    chunk.last = true;
+    chunk.fence = fence;
+    chunk.submission = GetCurrentSubmission();
+    chunk.wait_semaphores = std::move(current_submission_wait_semaphores_);
+    chunk.wait_stage_masks = std::move(current_submission_wait_stage_masks_);
+    current_submission_wait_semaphores_.clear();
+    current_submission_wait_stage_masks_.clear();
+    async_in_submission_ = false;
+  }
+  {
+    std::lock_guard<std::mutex> lock(async_mutex_);
+    async_queue_.push_back(std::move(chunk));
+  }
+  async_wake_.notify_one();
+}
+
+void VulkanCommandProcessor::AsyncChunkIfLarge() {
+  if (!async_submit_enabled_ || !submission_open_) {
+    return;
+  }
+  const size_t chunk_bytes = size_t(REXCVAR_GET(rcomp_async_chunk_kib)) << 10;
+  if (deferred_command_buffer_.SizeBytes() < chunk_bytes) {
+    return;
+  }
+  if (!async_in_submission_ && !EnsureCommandBufferWritable()) {
+    // EndSubmission reports it.
+    return;
+  }
+  HandOffChunk(false, VK_NULL_HANDLE);
+}
+
+void VulkanCommandProcessor::AwaitSubmitted(uint64_t submission) {
+  if (async_submitted_through_.load(std::memory_order_acquire) >= submission) {
+    return;
+  }
+  std::unique_lock<std::mutex> lock(async_mutex_);
+  async_done_.wait(lock, [this, submission] {
+    return async_submitted_through_.load(std::memory_order_acquire) >= submission;
+  });
+}
+
+void VulkanCommandProcessor::StopAsyncSubmitThread() {
+  if (!async_thread_.joinable()) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(async_mutex_);
+    async_stop_ = true;
+  }
+  async_wake_.notify_one();
+  async_thread_.join();
+  async_stop_ = false;
+  async_queue_.clear();
+  async_spare_.clear();
+  async_in_submission_ = false;
+}
