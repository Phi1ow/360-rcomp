+void VulkanSharedMemory::RcompStaleAudit() {
+  static const bool enabled = REXCVAR_GET(rcomp_stale_audit);
+  if (!enabled) {
+    return;
+  }
+  constexpr uint32_t kSlicePages = 1024;
+  static uint32_t cursor = 0;
+  static uint64_t calls = 0, scanned = 0, suspects_total = 0, stale = 0;
+  const uint32_t total_pages = uint32_t(rcomp_page_hashes_.size());
+  const size_t page_bytes = size_t(1) << page_size_log2();
+  auto hash_page = [&](uint32_t page) {
+    uint64_t hash = XXH3_64bits(memory().TranslatePhysical(page << page_size_log2()), page_bytes);
+    return hash ? hash : uint64_t(1);
+  };
+  auto pending_mark = [](uint32_t page) {
+    return __atomic_load_n(&::rcomp::g_guest_physical_written[page], __ATOMIC_ACQUIRE) != 0;
+  };
+  // The suspects of the previous call: still valid, still not written by the GPU, still no pending mark, and still not the bytes that were uploaded.
+  std::vector<uint32_t>& pages = rcomp_audit_pages_;
+  for (uint32_t page : rcomp_audit_suspects_) {
+    RcompGetValidCpuPages(page, 1, pages);
+    if (pages.empty() || !rcomp_page_hashes_[page] || pending_mark(page)) {
+      continue;
+    }
+    const uint64_t now = hash_page(page);
+    if (now != rcomp_page_hashes_[page] && !pending_mark(page)) {
+      ++stale;
+      if (stale <= 40) {
+        const uint8_t* head = memory().TranslatePhysical(page << page_size_log2());
+        std::fprintf(stderr, "RCOMP-STALE-PAGE page=0x%x frame=%llu uploaded_hash=%016llx guest_hash=%016llx head=", page,
+                     (unsigned long long)command_processor_.GetCurrentFrame(), (unsigned long long)rcomp_page_hashes_[page],
+                     (unsigned long long)now);
+        for (uint32_t i = 0; i < 32; ++i) {
+          std::fprintf(stderr, "%02x", head[i]);
+        }
+        std::fprintf(stderr, "\n");
+      }
+    }
+  }
+  rcomp_audit_suspects_.clear();
+  RcompGetValidCpuPages(cursor, kSlicePages, pages);
+  cursor += kSlicePages;
+  if (cursor >= total_pages) {
+    cursor = 0;
+  }
+  for (uint32_t page : pages) {
+    if (!rcomp_page_hashes_[page] || pending_mark(page)) {
+      continue;
+    }
+    ++scanned;
+    if (hash_page(page) != rcomp_page_hashes_[page] && !pending_mark(page)) {
+      rcomp_audit_suspects_.push_back(page);
+      ++suspects_total;
+    }
+  }
+  if ((++calls & 0x3F) == 0) {
+    std::fprintf(stderr, "RCOMP-STALE-AUDIT calls=%llu scanned_pages=%llu suspects=%llu stale=%llu\n", (unsigned long long)calls,
+                 (unsigned long long)scanned, (unsigned long long)suspects_total, (unsigned long long)stale);
+  }
+}
