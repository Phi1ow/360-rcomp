+                   last - first + 1, (unsigned long long)command_processor_.GetCurrentFrame());
+    }
+  }
+  if ((used & 0xFFFFF) == 0) {
+    std::fprintf(stderr, "RCOMP-STALE-VERTEX-COUNT used=%llu used_invalid=%llu invalid_pages=%llu\n", (unsigned long long)used,
+                 (unsigned long long)used_invalid, (unsigned long long)invalid_pages_total);
+  }
