+void SharedMemory::RcompGetValidCpuPages(uint32_t page_first, uint32_t page_count, std::vector<uint32_t>& pages_out) {
+  pages_out.clear();
+  const uint32_t total_pages = kBufferSize >> page_size_log2_;
+  if (page_first >= total_pages) {
+    return;
+  }
+  page_count = std::min(page_count, total_pages - page_first);
+  auto global_lock = global_critical_region_.Acquire();
+  for (uint32_t page = page_first; page < page_first + page_count; ++page) {
+    const uint64_t bit = uint64_t(1) << (page & 63);
+    if ((system_page_flags_valid_[page >> 6] & bit) && !(system_page_flags_valid_and_gpu_written_[page >> 6] & bit)) {
+      pages_out.push_back(page);
+    }
+  }
+}
+
+uint32_t SharedMemory::RcompCountInvalidPages(uint32_t page_first, uint32_t page_count) {
+  const uint32_t total_pages = kBufferSize >> page_size_log2_;
+  if (page_first >= total_pages) {
+    return 0;
+  }
+  page_count = std::min(page_count, total_pages - page_first);
+  uint32_t invalid = 0;
+  auto global_lock = global_critical_region_.Acquire();
+  for (uint32_t page = page_first; page < page_first + page_count; ++page) {
+    invalid += !(system_page_flags_valid_[page >> 6] & (uint64_t(1) << (page & 63)));
+  }
+  return invalid;
 }
 
