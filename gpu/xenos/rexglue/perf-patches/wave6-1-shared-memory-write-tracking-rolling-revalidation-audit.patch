+void VulkanSharedMemory::RcompAuditUsedRange(uint32_t start, uint32_t length) {
+  static const bool enabled = REXCVAR_GET(rcomp_stale_audit);
+  if (!enabled || !length) {
+    return;
+  }
+  static uint64_t used = 0, used_invalid = 0, invalid_pages_total = 0;
+  ++used;
+  const uint32_t first = start >> page_size_log2();
+  const uint32_t last = (start + length - 1) >> page_size_log2();
+  const uint32_t invalid = RcompCountInvalidPages(first, last - first + 1);
