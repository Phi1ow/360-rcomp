+bool VulkanPresenter::VisitGuestOutputImage(const std::function<bool(
+    const VulkanDevice*, VkImage, VkExtent2D, VkFormat, VkImageLayout)>& visitor) {
+  if (!visitor) return false;
+  uint32_t mailbox_index;
+  std::unique_lock<std::mutex> consumer_lock(
+      ConsumeGuestOutput(mailbox_index, nullptr, nullptr));
+  if (mailbox_index == UINT32_MAX) return false;
+  const auto& instance = guest_output_images_[mailbox_index];
+  if (!instance.ever_successfully_refreshed || !instance.image) return false;
+  const std::shared_ptr<GuestOutputImage> image = instance.image;
+  return visitor(vulkan_device_, image->image(), image->extent(),
+                 kGuestOutputFormat, kGuestOutputInternalLayout);
