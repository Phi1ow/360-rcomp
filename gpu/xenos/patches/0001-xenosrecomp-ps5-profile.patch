+#ifdef XENOS_RECOMP_PS5
+    {
+        // One sampled image + one sampler per (fetch constant, dimension) the
+        // shader actually uses. Set 1 = pixel stage, set 2 = vertex stage;
+        // binding = 2*slot (image), 2*slot+1 (sampler). A slot fetched with two
+        // dimensions in one shader is a generator error, not a silent alias.
+        StringBuffer decl;
+        std::map<uint32_t, std::string> bySlot;
+        for (auto& [slot, dim] : usedTextures)
+        {
+            auto ins = bySlot.emplace(slot, dim);
+            if (!ins.second && ins.first->second != dim)
+            {
+                fmt::println(stderr, "XenosRecomp(PS5): fetch constant {} used as {} and {}", slot, ins.first->second, dim);
+                std::abort();
+            }
+        }
+        const uint32_t set = isPixelShader ? 1 : 2;
+        for (auto& [slot, dim] : bySlot)
+        {
+            const char* type = dim == "2D" ? "Texture2D<float4>" : dim == "3D" ? "Texture3D<float4>" : dim == "Cube" ? "TextureCube<float4>" : nullptr;
+            if (type == nullptr)
+            {
+                fmt::println(stderr, "XenosRecomp(PS5): unsupported texture dimension {} on fetch constant {}", dim, slot);
+                std::abort();
+            }
+            decl.println("[[vk::binding({}, {})]] {} g_Texture{}_s{};", slot * 2, set, type, dim, slot);
+            decl.println("[[vk::binding({}, {})]] SamplerState g_Sampler_s{};", slot * 2 + 1, set, slot);
+        }
+        out.insert(resourceDeclarationOffset, decl.out);
+    }
+#endif
